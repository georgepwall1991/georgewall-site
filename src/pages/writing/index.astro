---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import PageIntro from '../../components/PageIntro.astro';
import WritingPreview from '../../components/WritingPreview.astro';
import Colophon from '../../components/Colophon.astro';
import { ARTICLES } from '../../data/writing';
---

<Base
  title="Writing | George Wall"
  description="Practical notes on .NET, Roslyn analysers, configuration, HTTP resilience and performance."
>
  <SiteHeader />
  <main id="main-content">
    <PageIntro
      kicker="Writing"
      title="Notes on bugs that compile cleanly."
      standfirst="Short write-ups on production problems, why tests miss them and what can be checked earlier with Roslyn."
      detail={`${ARTICLES.length} note${ARTICLES.length === 1 ? '' : 's'}`}
    />
    <WritingPreview />
  </main>
  <Colophon />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => element.classList.add('is-in'));
</script>
