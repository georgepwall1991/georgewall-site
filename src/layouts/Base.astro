---
// Self-hosted variable fonts (no external requests, no Google Fonts beacon).
import '@fontsource-variable/fraunces';
import '@fontsource-variable/archivo';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { snapshotFallback } from '../data/github';
import { SOCIALS } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD nodes merged into the page @graph (e.g. SoftwareApplication). */
  schema?: Record<string, unknown>[];
}

const {
  title = 'George Wall — Full-stack developer. I catch bugs before they ship.',
  description = 'London-based full-stack developer in financial services. I build .NET Roslyn analyzers, developer tooling, and iOS apps that catch bugs at compile-time.',
  schema = [],
} = Astro.props;

const SITE_URL = 'https://www.georgewall.uk';
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const ogImage = new URL('/og.png', Astro.site ?? SITE_URL).href;
const { user } = snapshotFallback;

const personSchema = {
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: 'George Wall',
  url: SITE_URL,
  image: user.avatar_url,
  jobTitle: 'Full-stack developer',
  description: user.bio,
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
  sameAs: SOCIALS,
  knowsAbout: [
    '.NET',
    'C#',
    'Roslyn analyzers',
    'Source generators',
    'TypeScript',
    'iOS',
    'SwiftUI',
    'Developer tooling',
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personSchema, ...schema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Resource hints: the portrait image and the live archive both hit GitHub. -->
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://api.github.com" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="George Wall" />
    <meta name="theme-color" content="#f4f0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14110b" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="George Wall" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="George Wall — full-stack developer portfolio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="George Wall — full-stack developer portfolio" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Flash-free theme: resolve before first paint. -->
    <script is:inline>
      (() => {
        // Mark JS as available so reveal-on-scroll hidden states apply only here.
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('atlas-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored ?? (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (_) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
