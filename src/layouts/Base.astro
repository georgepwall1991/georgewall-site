---
// Self-hosted variable fonts (no external requests, no Google Fonts beacon).
// The full Fraunces builds carry the optical-size, softness and wonk axes the
// design actually uses, plus a real italic instead of browser synthesis.
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/archivo";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { SITE, SOCIALS } from "../data/site";
import StatusBar from "../components/StatusBar.astro";

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD nodes merged into the page @graph (e.g. SoftwareApplication). */
  schema?: Record<string, unknown>[];
}

const {
  title = "George Wall — Product engineer and toolmaker",
  description = "London product engineer with 10+ years in fintech. Shipping React/.NET systems and App Store products, then building the analysers and tools that protect the next release.",
  schema = [],
} = Astro.props;

const SITE_URL = "https://www.georgewall.uk";
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const ogImage = new URL("/og.png", Astro.site ?? SITE_URL).href;
const personSchema = {
  "@type": "Person",
  "@id": `${SITE_URL}/#person`,
  name: "George Wall",
  url: SITE_URL,
  image: SITE.avatar,
  jobTitle: "Product engineer and toolmaker",
  description: SITE.bio,
  address: {
    "@type": "PostalAddress",
    addressLocality: "London",
    addressCountry: "GB",
  },
  sameAs: SOCIALS,
  knowsAbout: [
    ".NET",
    "C#",
    "Roslyn analysers",
    "Source generators",
    "React",
    "TypeScript",
    "Kafka",
    "Event-driven architecture",
    "iOS",
    "SwiftUI",
    "Developer tooling",
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [personSchema, ...schema],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Resource hints: the portrait image and the live archive both hit GitHub. -->
    <link
      rel="preconnect"
      href="https://avatars.githubusercontent.com"
      crossorigin
    />
    <link rel="dns-prefetch" href="https://api.github.com" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="George Wall" />
    <meta name="theme-color" content="#0b0d10" data-theme-colour />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="George Wall" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="George Wall — full-stack developer portfolio"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="George Wall — full-stack developer portfolio"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Flash-free theme: resolve before first paint. -->
    <script is:inline>
      (() => {
        // Mark JS as available so reveal-on-scroll hidden states apply only here.
        document.documentElement.classList.add("js");
        try {
          // Dark is the house default; light is an explicit choice.
          const stored = localStorage.getItem("atlas-theme");
          document.documentElement.dataset.theme = stored ?? "dark";
        } catch (_) {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <StatusBar />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
