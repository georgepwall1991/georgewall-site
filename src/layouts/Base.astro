---
// Self-hosted variable fonts (no external requests, no Google Fonts beacon).
import '@fontsource-variable/fraunces';
import '@fontsource-variable/archivo';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { snapshotFallback } from '../data/github';
import { SOCIALS } from '../data/site';
import StatusBar from '../components/StatusBar.astro';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD nodes merged into the page @graph (e.g. SoftwareApplication). */
  schema?: Record<string, unknown>[];
}

const {
  title = 'George Wall — Full-stack engineer. Catching bugs before they ship.',
  description = 'London-based full-stack engineer with 10+ years in fintech. React/TypeScript frontends, .NET back ends, Roslyn analysers and iOS apps — bugs caught before they turn expensive.',
  schema = [],
} = Astro.props;

const SITE_URL = 'https://www.georgewall.uk';
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const ogImage = new URL('/og.png', Astro.site ?? SITE_URL).href;
const { user } = snapshotFallback;

const personSchema = {
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: 'George Wall',
  url: SITE_URL,
  image: user.avatar_url,
  jobTitle: 'Full-stack engineer',
  description: user.bio,
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
  sameAs: SOCIALS,
  knowsAbout: [
    '.NET',
    'C#',
    'Roslyn analysers',
    'Source generators',
    'React',
    'TypeScript',
    'Kafka',
    'Event-driven architecture',
    'iOS',
    'SwiftUI',
    'Developer tooling',
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personSchema, ...schema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Resource hints: the portrait image and the live archive both hit GitHub. -->
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://api.github.com" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="George Wall" />
    <meta name="theme-color" content="#14110b" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="George Wall" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="George Wall — full-stack developer portfolio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="George Wall — full-stack developer portfolio" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Flash-free theme: resolve before first paint. -->
    <script is:inline>
      (() => {
        // Mark JS as available so reveal-on-scroll hidden states apply only here.
        document.documentElement.classList.add('js');
        try {
          // Dark is the house default; light is an explicit choice.
          const stored = localStorage.getItem('atlas-theme');
          document.documentElement.dataset.theme = stored ?? 'dark';
        } catch (_) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <StatusBar />
    <div class="cursor" aria-hidden="true">
      <span class="cursor__dot"></span>
      <span class="cursor__ring"></span>
    </div>
    <Analytics />
    <SpeedInsights />
    <script>
      // Custom cursor: dot tracks the pointer, ring lerps behind it and grows
      // over interactive targets. Fine pointers only; reduced-motion keeps the
      // native cursor (the CSS gate in global.css does the hiding).
      const cursor = document.querySelector<HTMLElement>('.cursor');
      const fine = window.matchMedia('(pointer: fine)').matches;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (cursor && fine && !reduce) {
        document.documentElement.classList.add('has-cursor');
        const dot = cursor.querySelector<HTMLElement>('.cursor__dot')!;
        const ring = cursor.querySelector<HTMLElement>('.cursor__ring')!;
        let x = -100,
          y = -100,
          rx = -100,
          ry = -100;

        window.addEventListener(
          'pointermove',
          (e) => {
            x = e.clientX;
            y = e.clientY;
            dot.style.transform = `translate(${x}px, ${y}px)`;
            const hot = (e.target as Element | null)?.closest?.('a, button, [role="button"], input, label');
            cursor.classList.toggle('is-hot', Boolean(hot));
          },
          { passive: true },
        );
        window.addEventListener('pointerdown', () => cursor.classList.add('is-down'));
        window.addEventListener('pointerup', () => cursor.classList.remove('is-down'));
        document.documentElement.addEventListener('pointerleave', () => cursor.classList.add('is-gone'));
        document.documentElement.addEventListener('pointerenter', () => cursor.classList.remove('is-gone'));

        const trail = () => {
          rx += (x - rx) * 0.16;
          ry += (y - ry) * 0.16;
          ring.style.transform = `translate(${rx}px, ${ry}px)`;
          requestAnimationFrame(trail);
        };
        requestAnimationFrame(trail);

        // Magnetic pull: buttons and masthead links lean toward the cursor.
        document.querySelectorAll<HTMLElement>('.btn, .masthead__nav a').forEach((el) => {
          const strength = el.classList.contains('btn') ? 0.3 : 0.2;
          el.addEventListener(
            'pointermove',
            (e) => {
              const r = el.getBoundingClientRect();
              el.style.setProperty('--mag-x', `${((e.clientX - (r.left + r.width / 2)) * strength).toFixed(1)}px`);
              el.style.setProperty('--mag-y', `${((e.clientY - (r.top + r.height / 2)) * strength).toFixed(1)}px`);
            },
            { passive: true },
          );
          el.addEventListener('pointerleave', () => {
            el.style.setProperty('--mag-x', '0px');
            el.style.setProperty('--mag-y', '0px');
          });
        });
      }
    </script>
  </body>
</html>
