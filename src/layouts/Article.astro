---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  slug: string;
  kicker: string;
  headline: string;
  standfirst: string;
  published: string;
  modified?: string;
  readingTime: string;
  keywords: string[];
  about?: { name: string; url: string };
}

const {
  title,
  description,
  slug,
  kicker,
  headline,
  standfirst,
  published,
  modified = published,
  readingTime,
  keywords,
  about,
} = Astro.props;
const canonical = `${SITE.url}/writing/${slug}`;
const displayDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(`${published}T12:00:00Z`));

const articleSchema = {
  '@type': 'TechArticle',
  '@id': `${canonical}#article`,
  headline,
  description,
  inLanguage: 'en-GB',
  datePublished: published,
  dateModified: modified,
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#person` },
  mainEntityOfPage: canonical,
  url: canonical,
  keywords,
  ...(about
    ? {
        about: {
          '@type': 'SoftwareApplication',
          name: about.name,
          applicationCategory: 'DeveloperApplication',
          url: about.url,
        },
      }
    : {}),
};
---

<Base title={title} description={description} schema={[articleSchema]}>
  <SiteHeader />
  <main class="article" id="main-content">
    <article class="wrap article__wrap">
      <nav class="article__crumbs" aria-label="Breadcrumb">
        <a class="link" href="/">George Wall</a>
        <span aria-hidden="true">/</span>
        <a class="link" href="/writing">Writing</a>
      </nav>

      <header class="article__head">
        <p class="kicker">{kicker}</p>
        <h1 class="display article__title">{headline}</h1>
        <p class="article__standfirst">{standfirst}</p>
        <p class="article__byline label">
          George Wall · London · <time datetime={published}>{displayDate}</time> · {readingTime}
        </p>
      </header>

      <div class="article__prose">
        <slot />
        <p class="article__back"><a class="link" href="/writing">← Back to writing</a></p>
      </div>
    </article>
  </main>

  <footer class="article__foot">
    <div class="wrap article__foot-inner">
      <p class="colophon-note">© {new Date().getFullYear()} · {SITE.domain} · Written by {SITE.name}, {SITE.location}.</p>
      <a class="link" href="/">Home ↑</a>
    </div>
  </footer>
</Base>

<style>
  .article {
    padding-top: clamp(2rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .article__wrap { max-width: 720px; }
  .article__crumbs {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  .article__head {
    padding-bottom: clamp(1.6rem, 4vw, 2.6rem);
    margin-bottom: clamp(2rem, 5vw, 3rem);
    border-bottom: 1.5px solid var(--ink);
  }
  .article__title {
    max-width: 16ch;
    margin: 1rem 0 1.4rem;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
  }
  .article__standfirst {
    max-width: 38ch;
    margin-bottom: 1.6rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 40, 'WONK' 1, 'wght' 460;
    font-style: italic;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    line-height: 1.34;
    color: var(--ink-soft);
  }
  .article__byline { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .article__prose {
    font-size: clamp(1.05rem, 1.2vw, 1.18rem);
    line-height: 1.66;
    color: var(--ink-soft);
  }
  :global(.article__prose > p + p) { margin-top: 1.3rem; }
  :global(.article__prose h2) {
    margin: 2.6rem 0 1rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72, 'WONK' 1, 'wght' 560;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  :global(.article__prose code) {
    padding: 0.1em 0.36em;
    border-radius: 4px;
    background: var(--paper-sunk);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }
  :global(.article__lead) { color: var(--ink); }
  :global(.article__lead::first-letter) {
    initial-letter: 3 2;
    -webkit-initial-letter: 3 2;
    margin-right: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent-text);
  }
  :global(.article__code) {
    margin: 1.8rem 0;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: var(--paper-raised);
  }
  :global(.article__code pre) { margin: 0; padding: 1.2rem 1.3rem; overflow-x: auto; }
  :global(.article__code pre code) {
    padding: 0;
    background: none;
    color: var(--ink);
    font-size: 0.82rem;
    line-height: 1.6;
    white-space: pre;
  }
  :global(.article__code figcaption) {
    padding: 0.8rem 1.3rem;
    border-top: 1px solid var(--rule);
    background: var(--paper-sunk);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-faint);
  }
  :global(.article__quote) {
    margin: 2.2rem 0;
    padding-left: 1.4rem;
    border-left: 3px solid var(--accent);
  }
  :global(.article__quote p) {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'WONK' 1, 'wght' 480;
    font-style: italic;
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    line-height: 1.32;
    color: var(--ink);
  }
  :global(.article__prose ul), :global(.article__prose ol) { margin: 1.2rem 0 1.2rem 1.4rem; }
  :global(.article__prose li + li) { margin-top: 0.55rem; }
  .article__back { margin-top: 2.6rem; font-family: var(--font-mono); font-size: 0.85rem; }
  .article__foot { padding: clamp(1.6rem, 4vw, 2.4rem) 0; border-top: 1.5px solid var(--ink); }
  .article__foot-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .colophon-note { color: var(--ink-faint); }
</style>
