---
import BuildConsole from "./BuildConsole.astro";
import { SITE } from "../data/site";

interface Props {
  totalDownloads: number;
  shippedApps: number;
}

const { totalDownloads, shippedApps } = Astro.props;
const downloadThousands = Math.floor(totalDownloads / 1000);
const downloadLabel = totalDownloads.toLocaleString("en-GB");
---

<section class="hero" id="lede">
  <div class="wrap">
    <div class="hero__meta intro" style="--intro-delay: 40ms">
      <span class="label">George Wall</span>
      <span class="hero__meta-rule" aria-hidden="true"></span>
      <span class="label">{SITE.location}</span>
      <span class="hero__meta-spacer"></span>
      <span class="label hero__meta-end">Products in public · protection in code</span>
    </div>

    <div class="hero__grid">
      <div class="hero__copy">
        <p class="kicker intro" style="--intro-delay: 100ms">
          Product engineering · 10+ years in fintech
        </p>

        <h1 class="hero__title">
          <span class="hero__line intro" style="--intro-delay: 180ms">
            Build the <em>thing.</em>
          </span>
          <span
            class="hero__line hero__line--middle intro"
            style="--intro-delay: 260ms"
          >
            Then build what
          </span>
          <span
            class="hero__line hero__line--fix intro"
            style="--intro-delay: 340ms"
          >
            protects it.
          </span>
        </h1>

        <div class="hero__outcome intro" style="--intro-delay: 420ms">
          <span>production fault</span>
          <i aria-hidden="true"><b></b></i>
          <strong>caught in the editor</strong>
        </div>

        <p class="hero__standfirst intro" style="--intro-delay: 500ms">
          I build <strong>React and .NET systems</strong>, ship my own <strong
            >iOS apps</strong
          >, then turn what I learn into analysers, source generators and CLIs.
        </p>

        <div class="hero__actions intro" style="--intro-delay: 580ms">
          <a href="#now" class="btn">
            Explore the work
            <span class="arrow" aria-hidden="true">↓</span>
          </a>
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener"
            class="btn btn--ghost"
          >
            GitHub
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero__instrument intro" style="--intro-delay: 400ms">
        <BuildConsole />
      </div>
    </div>

    <dl class="hero__stats intro" style="--intro-delay: 660ms">
      <div>
        <dt>NuGet reach</dt>
        <dd title={`${downloadLabel} total NuGet downloads`}>
          <strong>{downloadThousands}K+</strong>
          <span>downloads</span>
        </dd>
      </div>
      <div>
        <dt>Products shipped</dt>
        <dd><strong>{shippedApps}</strong> <span>live on the App Store</span></dd>
      </div>
      <div>
        <dt>Production depth</dt>
        <dd><strong>10+</strong> <span>years in fintech</span></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(1.5rem, 3.5vw, 3rem) clamp(3.8rem, 8vw, 7rem);
    overflow-x: clip;
  }

  .hero::before {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px),
      radial-gradient(circle at 76% 38%, var(--fix-wash), transparent 28%),
      radial-gradient(circle at 16% 58%, var(--fault-wash), transparent 23%);
    background-size: 4rem 4rem, 4rem 4rem, auto, auto;
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.52), transparent 90%);
    opacity: 0.46;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 2.6rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule);
    flex-wrap: wrap;
  }

  .hero__meta-rule {
    width: 1px;
    height: 0.85rem;
    background: var(--rule-strong);
  }

  .hero__meta-spacer {
    flex: 1;
  }

  .hero__meta-end {
    color: var(--ink-soft);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(36rem, 1.08fr);
    gap: clamp(2.5rem, 4.5vw, 4.75rem);
    align-items: center;
    padding-top: clamp(2.5rem, 5vw, 4.4rem);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .hero__copy > .kicker {
    margin-bottom: clamp(1.45rem, 2.5vw, 2.2rem);
  }

  .hero__title {
    font-family: var(--font-sans);
    font-size: clamp(3.65rem, 5.75vw, 5.4rem);
    font-variation-settings: "wght" 790;
    line-height: 0.84;
    letter-spacing: -0.068em;
  }

  .hero__line {
    display: block;
    width: fit-content;
    max-width: 100%;
  }

  .hero__line em {
    color: var(--fault);
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: "opsz" 144, "WONK" 1, "wght" 520;
    font-weight: 520;
    letter-spacing: -0.045em;
  }

  .hero__line--middle {
    margin-top: 0.08em;
    margin-left: clamp(0rem, 2.5vw, 2rem);
    font-size: 0.84em;
    letter-spacing: -0.055em;
  }

  .hero__line--fix {
    margin-top: 0.12em;
    margin-left: clamp(1.1rem, 5.2vw, 4.6rem);
    color: var(--fix);
  }

  .hero__outcome {
    display: grid;
    grid-template-columns: auto minmax(2.8rem, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    max-width: 32rem;
    margin-top: clamp(1.1rem, 2vw, 1.55rem);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .hero__outcome i {
    position: relative;
    height: 1px;
    background: linear-gradient(90deg, var(--fault), var(--rule-strong), var(--fix));
  }

  .hero__outcome i::before,
  .hero__outcome i::after,
  .hero__outcome b {
    position: absolute;
    top: 50%;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    content: "";
    transform: translateY(-50%);
  }

  .hero__outcome i::before {
    left: 0;
    border: 1px solid var(--fault);
    background: var(--paper);
  }

  .hero__outcome i::after {
    right: 0;
    border: 1px solid var(--fix);
    background: var(--paper);
  }

  .hero__outcome b {
    left: 0;
    width: 0.3rem;
    height: 0.3rem;
    background: var(--fix);
    box-shadow: 0 0 0.55rem var(--fix);
    animation: outcome-route 3.4s var(--ease) infinite;
  }

  .hero__outcome strong {
    color: var(--fix);
    font-weight: 550;
  }

  .hero__standfirst {
    max-width: 44ch;
    margin-top: clamp(1.7rem, 3vw, 2.4rem);
    color: var(--ink-soft);
    font-size: clamp(1.03rem, 1.32vw, 1.2rem);
    line-height: 1.56;
  }

  .hero__standfirst strong {
    color: var(--ink);
    font-weight: 620;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.78rem;
    margin-top: 1.8rem;
  }

  .hero__instrument {
    position: relative;
    min-width: 0;
  }

  .hero__instrument::before {
    position: absolute;
    inset: 9% 3% -8%;
    z-index: -1;
    content: "";
    border-radius: 50%;
    background: color-mix(in srgb, var(--fix) 16%, transparent);
    filter: blur(3.6rem);
    opacity: 0.82;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(2.5rem, 4.5vw, 4rem);
    border-block: 1px solid var(--rule-strong);
  }

  .hero__stats > div {
    min-width: 0;
    padding: 0.95rem clamp(0.85rem, 2vw, 1.65rem) 1.05rem;
  }

  .hero__stats > div + div {
    border-left: 1px solid var(--rule);
  }

  .hero__stats dt {
    margin-bottom: 0.38rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.59rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__stats dd {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.45vw, 1.15rem);
  }

  .hero__stats dd strong {
    font-weight: 580;
  }

  .hero__stats dd span {
    color: var(--ink-soft);
    font-size: 0.69em;
  }

  @keyframes outcome-route {
    0%,
    15% {
      left: 0;
      background: var(--fault);
      box-shadow: 0 0 0.55rem var(--fault);
    }
    82%,
    100% {
      left: calc(100% - 0.3rem);
      background: var(--fix);
      box-shadow: 0 0 0.55rem var(--fix);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__outcome b {
      left: calc(100% - 0.3rem);
      animation: none;
    }
  }

  @media (max-width: 1180px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__copy {
      max-width: 46rem;
    }

    .hero__instrument {
      width: 100%;
      max-width: 52rem;
    }

    .hero__title {
      font-size: clamp(4.4rem, 8.8vw, 6.25rem);
    }
  }

  @media (max-width: 650px) {
    .hero {
      padding-top: 0.8rem;
    }

    .hero__meta-spacer,
    .hero__meta-end {
      display: none;
    }

    .hero__grid {
      gap: 2.8rem;
      padding-top: 2rem;
    }

    .hero__copy > .kicker {
      margin-bottom: 1.35rem;
    }

    .hero__title {
      font-size: clamp(2.85rem, 13.9vw, 4.35rem);
      line-height: 0.87;
    }

    .hero__line--middle {
      margin-left: 0;
      font-size: 0.8em;
    }

    .hero__line--fix {
      margin-left: clamp(0.9rem, 8vw, 2.2rem);
    }

    .hero__outcome {
      grid-template-columns: auto minmax(1.5rem, 1fr) auto;
      gap: 0.38rem;
      font-size: clamp(0.42rem, 2vw, 0.52rem);
    }

    .hero__stats > div {
      padding-inline: 0.55rem;
    }

    .hero__stats dt {
      font-size: clamp(0.43rem, 1.75vw, 0.54rem);
      letter-spacing: 0.07em;
    }

    .hero__stats dd {
      font-size: clamp(0.72rem, 3vw, 0.92rem);
      line-height: 1.25;
    }

    .hero__stats dd span {
      display: block;
      margin-top: 0.16rem;
    }
  }

  @media (max-width: 360px) {
    .hero__outcome span {
      display: none;
    }

    .hero__outcome {
      grid-template-columns: minmax(2rem, 1fr) auto;
    }
  }
</style>
