---
import BuildConsole from "./BuildConsole.astro";
import { SITE } from "../data/site";

interface Props {
  totalDownloads: number;
  shippedApps: number;
}

const { totalDownloads, shippedApps } = Astro.props;
const downloadThousands = Math.floor(totalDownloads / 1000);
---

<section class="hero" id="lede">
  <div class="wrap">
    <div class="hero__meta intro" style="--intro-delay: 40ms">
      <span class="label">George Wall</span>
      <span class="hero__meta-rule" aria-hidden="true"></span>
      <span class="label">{SITE.location}</span>
      <span class="hero__meta-spacer"></span>
      <span class="label hero__meta-end"
        >Full-stack systems · developer tooling</span
      >
    </div>

    <div class="hero__grid">
      <div class="hero__copy">
        <p class="kicker intro" style="--intro-delay: 120ms">
          Product engineering · 10+ years in fintech
        </p>

        <h1 class="hero__title">
          <span class="intro-mask">
            <span class="hero__line intro-line" style="--intro-delay: 200ms">
              Build the <em>thing.</em>
            </span>
          </span>
          <span class="intro-mask">
            <span
              class="hero__line hero__line--middle intro-line"
              style="--intro-delay: 300ms"
            >
              Then build what
            </span>
          </span>
          <span class="intro-mask">
            <span
              class="hero__line hero__line--fix intro-line"
              style="--intro-delay: 400ms"
            >
              protects it<span aria-hidden="true">.</span>
            </span>
          </span>
        </h1>

        <p class="hero__standfirst intro" style="--intro-delay: 500ms">
          I ship <strong>React and .NET systems</strong> and <strong
            >App Store products</strong
          > — then turn the production lessons into analysers, source generators
          and CLIs that make the next release safer.
        </p>

        <div class="hero__actions intro" style="--intro-delay: 600ms">
          <a href="#now" class="btn">
            See what moved
            <span class="arrow" aria-hidden="true">↓</span>
          </a>
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener"
            class="btn btn--ghost"
          >
            GitHub
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero__instrument intro" style="--intro-delay: 460ms">
        <BuildConsole />
      </div>
    </div>

    <dl class="hero__stats intro" style="--intro-delay: 700ms">
      <div>
        <dt>Open-source adoption</dt>
        <dd data-nuget-adoption data-total={totalDownloads}>
          <strong data-nuget-total aria-live="polite"
            >{downloadThousands}K+</strong
          >
          <span>NuGet downloads</span>
        </dd>
      </div>
      <div>
        <dt>Products shipped</dt>
        <dd>{shippedApps} <span>live App Store releases</span></dd>
      </div>
      <div>
        <dt>Delivery context</dt>
        <dd>10+ <span>years in fintech</span></dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import { PACKAGE_IDS } from "../data/nuget";

  interface AdoptionCache {
    total: number;
    checkedAt: number;
  }

  interface NuGetSearchHit {
    id?: string;
    totalDownloads?: number;
  }

  const adoption = document.querySelector<HTMLElement>("[data-nuget-adoption]");
  const totalNode = adoption?.querySelector<HTMLElement>("[data-nuget-total]");

  if (adoption && totalNode) {
    const oneDay = 24 * 60 * 60 * 1000;
    const cacheKey = `georgewall:nuget-adoption:${PACKAGE_IDS.join("|")}`;
    const builtTotal = Number(adoption.dataset.total) || 0;

    const renderTotal = (total: number, checkedAt?: number) => {
      const safeTotal = Math.max(builtTotal, total);
      totalNode.textContent = `${Math.floor(safeTotal / 1000)}K+`;
      adoption.dataset.total = String(safeTotal);
      adoption.title = `${safeTotal.toLocaleString("en-GB")} total NuGet downloads${
        checkedAt
          ? ` · checked ${new Date(checkedAt).toLocaleDateString("en-GB")}`
          : ""
      }`;
    };

    const readCache = (): AdoptionCache | undefined => {
      try {
        const parsed = JSON.parse(
          localStorage.getItem(cacheKey) ?? "null",
        ) as AdoptionCache | null;
        if (
          parsed &&
          Number.isFinite(parsed.total) &&
          Number.isFinite(parsed.checkedAt)
        ) {
          return parsed;
        }
      } catch {
        // Storage is an enhancement; the build-time value remains usable.
      }
      return undefined;
    };

    const writeCache = (snapshot: AdoptionCache) => {
      try {
        localStorage.setItem(cacheKey, JSON.stringify(snapshot));
      } catch {
        // Private browsing and strict storage policies should not break the stat.
      }
    };

    const cached = readCache();
    if (cached) renderTotal(cached.total, cached.checkedAt);

    if (!cached || Date.now() - cached.checkedAt >= oneDay) {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 6000);

      Promise.all(
        PACKAGE_IDS.map(async (id) => {
          const query = encodeURIComponent(`packageid:${id}`);
          const response = await fetch(
            `https://azuresearch-usnc.nuget.org/query?q=${query}&prerelease=true&take=5`,
            {
              signal: controller.signal,
              headers: { Accept: "application/json" },
            },
          );
          if (!response.ok) throw new Error(`NuGet ${response.status}`);

          const payload = (await response.json()) as {
            data?: NuGetSearchHit[];
          };
          const hit = payload.data?.find(
            (item) => item.id?.toLowerCase() === id.toLowerCase(),
          );
          if (!Number.isFinite(hit?.totalDownloads)) {
            throw new Error(`NuGet package ${id} missing from response`);
          }
          return hit!.totalDownloads!;
        }),
      )
        .then((downloads) => {
          const snapshot = {
            total: downloads.reduce((sum, count) => sum + count, 0),
            checkedAt: Date.now(),
          };
          writeCache(snapshot);
          renderTotal(snapshot.total, snapshot.checkedAt);
        })
        .catch(() => {
          // Keep the cached or build-time value when NuGet is unavailable.
        })
        .finally(() => window.clearTimeout(timer));
    } else {
      renderTotal(cached.total, cached.checkedAt);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.2), transparent 72%);
    opacity: 0.32;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
    flex-wrap: wrap;
  }

  .hero__meta-rule {
    width: 1px;
    height: 0.9rem;
    background: var(--rule-strong);
  }

  .hero__meta-spacer {
    flex: 1;
  }

  .hero__meta-end {
    color: var(--ink-soft);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(25rem, 0.97fr);
    gap: clamp(2.5rem, 5vw, 5.5rem);
    align-items: center;
    padding-top: clamp(2.5rem, 5.5vw, 5rem);
  }

  .hero__copy > .kicker {
    margin-bottom: clamp(1.5rem, 3vw, 2.4rem);
  }

  .hero__title {
    font-family: var(--font-sans);
    font-variation-settings: "wght" 790;
    font-size: clamp(3.45rem, 5.85vw, 5.9rem);
    line-height: 0.84;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .hero__line {
    display: block;
  }

  .hero__line em {
    color: var(--fault);
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 144,
      "WONK" 1,
      "wght" 520;
    font-weight: 520;
  }

  .hero__line--middle {
    padding-left: clamp(0rem, 3vw, 2.5rem);
  }

  .hero__line--fix {
    position: relative;
    width: fit-content;
    margin-left: clamp(2.5rem, 8vw, 7rem);
    color: var(--fix);
  }

  .hero__line--fix::after {
    content: "production hardened";
    position: absolute;
    left: calc(100% + 1.1rem);
    bottom: 0.12em;
    width: max-content;
    font-family: var(--font-mono);
    font-size: clamp(0.58rem, 0.85vw, 0.72rem);
    font-variation-settings: "wght" 520;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--fix);
  }

  .hero__standfirst {
    max-width: 47ch;
    margin-top: clamp(2rem, 4vw, 3rem);
    font-size: clamp(1.04rem, 1.35vw, 1.24rem);
    line-height: 1.58;
    color: var(--ink-soft);
  }

  .hero__standfirst strong {
    color: var(--ink);
    font-weight: 610;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero__instrument {
    min-width: 0;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  .hero__stats > div {
    padding: 1rem clamp(1rem, 2.2vw, 1.8rem) 1.15rem;
  }

  .hero__stats > div + div {
    border-left: 1px solid var(--rule);
  }

  .hero__stats dt {
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .hero__stats dd {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: var(--ink);
  }

  .hero__stats dd strong {
    font-weight: inherit;
  }

  .hero__stats dd span {
    color: var(--ink-soft);
    font-size: 0.72em;
  }

  @media (max-width: 1050px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__instrument {
      max-width: 46rem;
    }

    .hero__title {
      max-width: 10ch;
    }
  }

  @media (max-width: 650px) {
    .hero__meta-spacer,
    .hero__meta-end {
      display: none;
    }

    .hero__grid {
      padding-top: 2.2rem;
      gap: 2.8rem;
    }

    .hero__title {
      font-size: clamp(3.1rem, 14vw, 4.6rem);
      line-height: 0.88;
    }

    .hero__line--middle {
      padding-left: 0;
    }

    .hero__line--fix {
      margin-left: 1.6rem;
    }

    .hero__line--fix::after {
      display: none;
    }

    .hero__stats {
      grid-template-columns: 1fr;
    }

    .hero__stats > div + div {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
