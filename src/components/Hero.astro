---
import DiagnosticHero from './DiagnosticHero.astro';
import { SITE } from '../data/site';
import { formatCount } from '../lib/format';

interface Props {
  repoCount: number;
  totalStars: number;
}
const { repoCount, totalStars } = Astro.props;

// The brand squiggle at architectural scale: one long wave path that draws
// itself behind the headline on load.
const waveTail = Array.from({ length: 32 }, (_, i) => `T${160 + i * 80} 80`).join(' ');
const wavePath = `M0 80 Q40 0 80 80 ${waveTail}`;
---

<section class="hero" id="lede">
  <div class="hero__glow" aria-hidden="true"></div>
  <svg
    class="hero__squiggle"
    viewBox="0 0 2720 160"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d={wavePath} pathLength="1"></path>
  </svg>
  <div class="wrap">
    <div class="hero__meta intro" style="--intro-delay: 60ms">
      <span class="label">№&nbsp;{SITE.issueNo}</span>
      <span class="hero__meta-rule" aria-hidden="true"></span>
      <span class="label">{SITE.location}</span>
      <span class="hero__meta-rule" aria-hidden="true"></span>
      <span class="label">{SITE.issueYear}</span>
      <span class="hero__meta-spacer"></span>
      <span class="label hero__meta-end">Open source &amp; selected works</span>
    </div>

    <p class="kicker hero__kicker intro" style="--intro-delay: 160ms">{SITE.role} · 10+ years in fintech</p>

    <h1 class="display hero__title">
      <span class="intro-mask">
        <span class="hero__line intro-line" style="--intro-delay: 260ms">Catching <span class="hero__flag">bugs</span></span>
      </span>
      <span class="intro-mask">
        <span class="hero__line hero__line--indent hero__line--slam intro-line" style="--intro-delay: 380ms"
          >before they ship.</span
        >
      </span>
    </h1>

    <div class="hero__grid">
      <div class="hero__main">
        <p class="hero__standfirst intro" style="--intro-delay: 540ms">
          I’m George — a full-stack engineer who builds the whole thing:
          <strong>React/TypeScript frontends</strong>, <strong>.NET back ends</strong> and
          <strong>iOS apps</strong> — plus the <strong>Roslyn analysers</strong> that move a
          failure from a late-night incident to a red squiggle in your editor.
        </p>

        <div class="hero__actions intro" style="--intro-delay: 660ms">
          <a href="#work" class="btn">
            Selected work
            <span class="arrow" aria-hidden="true">↓</span>
          </a>
          <a href={SITE.github} target="_blank" rel="noopener" class="btn btn--ghost">
            GitHub
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <dl class="hero__stats intro" style="--intro-delay: 780ms">
          <div>
            <dt class="label">Public repos</dt>
            <dd><span class="stat" data-count={repoCount}>{repoCount}</span></dd>
          </div>
          <div>
            <dt class="label">GitHub stars</dt>
            <dd>
              <span class="stat" data-count={totalStars}>{formatCount(totalStars)}</span><span
                class="hero__star">★</span
              >
            </dd>
          </div>
          <div>
            <dt class="label">Years in fintech</dt>
            <dd><span class="stat" data-count="10">10</span><span class="hero__star">+</span></dd>
          </div>
        </dl>
      </div>

      <div class="hero__aside intro" style="--intro-delay: 480ms">
        <DiagnosticHero />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  /* Cursor spotlight: a soft accent pool that follows the pointer. */
  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.7s ease;
    background: radial-gradient(
      560px circle at var(--gx, 50%) var(--gy, 40%),
      var(--accent-wash) 0%,
      transparent 70%
    );
  }
  .hero:hover .hero__glow {
    opacity: 1;
  }

  /* The motif at architectural scale: faint, tilted, drawing itself in. */
  .hero__squiggle {
    position: absolute;
    top: 44%;
    left: -4%;
    width: 110%;
    height: clamp(6rem, 14vw, 12rem);
    transform: rotate(-3.5deg);
    z-index: 0;
    pointer-events: none;
  }
  .hero__squiggle path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 14;
    stroke-linecap: round;
    opacity: 0.09;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: squiggle-draw 2.6s var(--ease) 0.45s forwards;
  }

  @keyframes squiggle-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__squiggle path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--rule);
    flex-wrap: wrap;
  }
  .hero__meta-rule {
    width: 1px;
    height: 0.9rem;
    background: var(--rule-strong);
  }
  .hero__meta-spacer {
    flex: 1;
  }
  .hero__meta-end {
    color: var(--ink-soft);
  }

  /* The headline runs full-bleed across the page; standfirst + editor card
     sit in a grid beneath it. */
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-top: clamp(2.2rem, 5vw, 3.8rem);
  }

  .hero__kicker {
    margin: clamp(2.2rem, 5vw, 3.6rem) 0 1.4rem;
  }

  .hero__title {
    font-size: clamp(3.2rem, 9.4vw, 8rem);
    margin-bottom: 0;
  }
  .hero__line {
    display: block;
  }
  .hero__line--indent {
    /* The second line steps in — an editorial stagger across the full bleed. */
    padding-left: clamp(2.5rem, 8vw, 7rem);
    color: var(--ink);
  }

  /* The slam: the payoff line switches voice — grotesque caps, outline only,
     filling with ink when you reach for it. */
  .hero__line--slam {
    font-family: var(--font-sans);
    font-variation-settings: 'wght' 820;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    font-size: 0.78em;
    line-height: 1.06;
    color: transparent;
    -webkit-text-stroke: 0.022em var(--ink);
    transition: color 0.45s var(--ease);
  }
  .hero__title:hover .hero__line--slam:not(.slam--js) {
    color: var(--ink);
  }

  /* Per-letter illumination (JS splits the line on fine pointers): letters
     near the cursor catch fire as it sweeps across. */
  .hero__line--slam :global(.slam-ch) {
    transition: color 0.3s var(--ease), -webkit-text-stroke-color 0.3s var(--ease);
  }
  .hero__line--slam :global(.slam-ch.is-lit) {
    color: var(--accent);
    -webkit-text-stroke-color: var(--accent);
  }

  .hero__flag {
    position: relative;
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'WONK' 1, 'wght' 560;
    white-space: nowrap;
  }
  .hero__flag::after {
    content: '';
    position: absolute;
    left: -0.02em;
    right: -0.02em;
    bottom: 0.04em;
    height: 0.16em;
    background-color: var(--accent);
    -webkit-mask: var(--wave) repeat-x left bottom / 0.5em 0.16em;
    mask: var(--wave) repeat-x left bottom / 0.5em 0.16em;
    transform: scaleX(0);
    transform-origin: 0 50%;
    animation: hero-flag 0.9s var(--ease) 0.7s forwards;
  }

  .hero__standfirst {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.4vw, 1.28rem);
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }
  .hero__standfirst strong {
    color: var(--ink);
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 2.6rem;
  }

  .hero__stats {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    padding-top: 1.6rem;
    border-top: 1px solid var(--rule);
  }
  .hero__stats dt {
    margin-bottom: 0.4rem;
  }
  .hero__stats dd {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'WONK' 0, 'wght' 540;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1;
  }
  .hero__star {
    color: var(--accent);
    font-size: 0.6em;
    vertical-align: 0.3em;
    margin-left: 0.1em;
  }

  .hero__aside {
    /* lifts the editor card slightly off the baseline for editorial tension */
    transform: translateY(-0.5rem);
  }

  @keyframes hero-flag {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__flag::after {
      animation: none;
      transform: scaleX(1);
    }
  }

  @media (max-width: 940px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero__aside {
      transform: none;
      max-width: 32rem;
    }
  }
</style>

<script>
  // Count-up for the hero stats, timed to land with their intro reveal.
  // No-JS and reduced-motion keep the server-rendered final values.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;
  const hero = document.querySelector<HTMLElement>('.hero');

  // Cursor spotlight: feed the glow gradient the pointer position.
  if (hero && fine && !reduce) {
    const glow = hero.querySelector<HTMLElement>('.hero__glow');
    hero.addEventListener(
      'pointermove',
      (e) => {
        if (!glow) return;
        const r = hero.getBoundingClientRect();
        glow.style.setProperty('--gx', `${e.clientX - r.left}px`);
        glow.style.setProperty('--gy', `${e.clientY - r.top}px`);
      },
      { passive: true },
    );
  }

  // Per-letter slam illumination: split the payoff line into characters and
  // light the ones near the cursor. Screen readers get the intact text via an
  // sr-only span; the visual letters are aria-hidden.
  const slam = document.querySelector<HTMLElement>('.hero__line--slam');
  if (slam && hero && fine && !reduce) {
    const text = slam.textContent ?? '';
    slam.classList.add('slam--js');
    slam.textContent = '';
    const sr = document.createElement('span');
    sr.className = 'sr-only';
    sr.textContent = text;
    slam.appendChild(sr);
    const chars: HTMLElement[] = [];
    for (const ch of text) {
      const s = document.createElement('span');
      s.className = 'slam-ch';
      s.setAttribute('aria-hidden', 'true');
      s.textContent = ch;
      slam.appendChild(s);
      chars.push(s);
    }
    let raf = 0;
    hero.addEventListener(
      'pointermove',
      (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          for (const s of chars) {
            const r = s.getBoundingClientRect();
            const d = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2));
            s.classList.toggle('is-lit', d < 150);
          }
        });
      },
      { passive: true },
    );
    hero.addEventListener('pointerleave', () => chars.forEach((s) => s.classList.remove('is-lit')));
  }

  if (!reduce) {
    document.querySelectorAll<HTMLElement>('.hero__stats .stat').forEach((el) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      const final = el.textContent ?? '';
      const start = performance.now() + 750;
      const duration = 1300;
      const tick = (t: number) => {
        const p = Math.min(Math.max((t - start) / duration, 0), 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = p >= 1 ? final : String(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>
