---
import { ARTICLES } from '../data/writing';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(`${iso}T12:00:00Z`),
  );
---

<section class:list={['writing-preview', { 'writing-preview--compact': compact }]} id="writing" aria-labelledby="writing-title">
  <div class="wrap">
    <header class="writing-preview__head reveal">
      <div>
        <p class="kicker">Writing</p>
        <h2 class="display writing-preview__title" id="writing-title">Notes from the failure boundary.</h2>
      </div>
      <p class="writing-preview__intro">
        Practical essays about the bugs that escape tests, the tools that catch them, and the
        decisions hidden inside “it works”.
      </p>
    </header>

    <ol class="writing-preview__list">
      {
        ARTICLES.map((article, index) => (
          <li class="writing-card reveal" style={`--reveal-delay:${index * 90}ms`}>
            <a href={`/writing/${article.slug}`} class="writing-card__link">
              <span class="writing-card__no">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p class="kicker writing-card__kicker">{article.kicker}</p>
                <h3 class="writing-card__title">{article.title}</h3>
                <p class="writing-card__description">{article.description}</p>
              </div>
              <div class="writing-card__meta">
                <time datetime={article.published}>{formatDate(article.published)}</time>
                <span>{article.readingTime}</span>
                <span class="writing-card__arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>

    {
      compact && (
        <div class="writing-preview__more reveal">
          <a class="btn btn--ghost" href="/writing">
            Visit the writing desk <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .writing-preview {
    padding-top: var(--section-gap);
  }
  .writing-preview__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.55fr);
    align-items: end;
    gap: clamp(1.5rem, 6vw, 5rem);
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .writing-preview__title {
    max-width: 14ch;
    margin-top: 0.9rem;
    font-size: clamp(2.4rem, 5.5vw, 4.8rem);
  }
  .writing-preview__intro {
    max-width: 39ch;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .writing-preview__list {
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }
  .writing-card {
    border-bottom: 1px solid var(--rule);
  }
  .writing-card__link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    min-height: 11rem;
    padding: 1.8rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .writing-card__no,
  .writing-card__meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .writing-card__no {
    align-self: start;
    color: var(--accent-text);
  }
  .writing-card__kicker {
    margin-bottom: 0.8rem;
  }
  .writing-card__title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 90, 'WONK' 1, 'wght' 540;
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .writing-card__description {
    max-width: 58ch;
    margin-top: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .writing-card__meta {
    display: grid;
    gap: 0.45rem;
    min-width: 10rem;
    text-align: right;
  }
  .writing-card__arrow {
    margin-top: 0.35rem;
    color: var(--accent-text);
    font-size: 1.2rem;
    transition: transform 0.3s var(--ease);
  }
  .writing-card__link:hover .writing-card__arrow,
  .writing-card__link:focus-visible .writing-card__arrow {
    transform: translate(4px, -4px);
  }
  .writing-preview__more {
    display: flex;
    justify-content: center;
    padding-top: 2rem;
  }
  @media (max-width: 760px) {
    .writing-preview__head {
      grid-template-columns: 1fr;
    }
    .writing-card__link {
      grid-template-columns: 2rem 1fr;
    }
    .writing-card__meta {
      grid-column: 2;
      grid-template-columns: repeat(2, max-content) 1fr;
      align-items: center;
      min-width: 0;
      text-align: left;
    }
    .writing-card__arrow {
      justify-self: end;
      margin: 0;
    }
  }
</style>
