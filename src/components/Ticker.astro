---
// Decorative full-bleed marquee between the lede and the contents: the stack,
// shouted in outlined display caps. Pure CSS — the track holds the list twice
// and slides by exactly half, so the loop is seamless at any width.
const ITEMS = [
  'Full-stack',
  'React',
  'TypeScript',
  '.NET & C#',
  'Kafka',
  'Swift',
  'Roslyn',
  'Rust',
];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {
      [0, 1].map(() => (
        <div class="ticker__group">
          {ITEMS.map((item) => (
            <span class="ticker__item">
              {item}
              <span class="ticker__mark">✳</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    border-top: 1px solid var(--rule);
    overflow: hidden;
    user-select: none;
    padding-block: clamp(0.7rem, 1.6vw, 1.2rem);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 36s linear infinite;
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__group {
    display: flex;
    flex: none;
    align-items: baseline;
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    padding-left: clamp(1.4rem, 3vw, 2.6rem);
    font-family: var(--font-sans);
    font-variation-settings: 'wght' 800;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 0.025em var(--ink-faint);
    transition: -webkit-text-stroke-color 0.4s ease, color 0.4s ease;
  }

  /* Reach for it and the words fill with ink. */
  .ticker:hover .ticker__item {
    -webkit-text-stroke-color: var(--ink);
  }

  .ticker__mark {
    color: var(--accent);
    -webkit-text-stroke: 0;
    font-size: 0.5em;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* When the JS driver takes over, the CSS loop stands down. */
  :global(html.ticker-js) .ticker__track {
    animation: none;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
  }
</style>

<script>
  // Scroll-reactive marquee: cruises on its own, surges with scroll velocity,
  // skews with momentum, and runs backwards when you scroll up. The CSS
  // animation remains as the no-JS / reduced-motion fallback.
  const track = document.querySelector<HTMLElement>('.ticker__track');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (track && !reduce) {
    document.documentElement.classList.add('ticker-js');
    let x = 0;
    let vel = 0;
    let lastY = window.scrollY;
    let half = track.scrollWidth / 2;
    let paused = false;
    window.addEventListener('resize', () => (half = track.scrollWidth / 2), { passive: true });
    track.parentElement?.addEventListener('pointerenter', () => (paused = true));
    track.parentElement?.addEventListener('pointerleave', () => (paused = false));

    let last = performance.now();
    const loop = (t: number) => {
      const dt = Math.min((t - last) / 1000, 0.05);
      last = t;
      vel += window.scrollY - lastY;
      lastY = window.scrollY;
      vel *= 0.9;
      const speed = paused ? 0 : 60 + vel * 7;
      x = (((x + speed * dt) % half) + half) % half;
      const skew = Math.max(-5, Math.min(5, vel * 0.05));
      track.style.transform = `translateX(${-x}px) skewX(${-skew}deg)`;
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>
