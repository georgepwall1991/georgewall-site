---
const products = [
  { name: "NoBooze", version: "1.6.1" },
  { name: "GemGame", version: "2.1.6" },
  { name: "Fleet Commander", version: "1.0.5" },
];

const traceStages = [
  {
    code: "days",
    label: "Production",
    title: "A user finds it.",
    copy: "The fault is live, someone is blocked and the useful context is already fading.",
    diagnostic: "INCIDENT-827",
    output: "user report → triage",
  },
  {
    code: "hours",
    label: "Runtime",
    title: "The system spots it.",
    copy: "Telemetry narrows the search, but the broken path is already running.",
    diagnostic: "TRACE-502",
    output: "stack trace → isolate",
  },
  {
    code: "minutes",
    label: "Tests",
    title: "A test catches it.",
    copy: "The release stops before deployment, with enough evidence to reproduce the fault.",
    diagnostic: "TEST-RED",
    output: "red test → reproduce",
  },
  {
    code: "seconds",
    label: "Build",
    title: "The build rejects it.",
    copy: "A hard-won production lesson becomes a rule the whole codebase can enforce.",
    diagnostic: "LINQ001",
    output: "diagnostic → build blocked",
  },
  {
    code: "now",
    label: "Editor",
    title: "Fixed while I type.",
    copy: "The same mistake is flagged while the intent is fresh, with the repair ready to apply.",
    diagnostic: "QUICK-FIX",
    output: "one click → safe code",
  },
];
---

<figure class="compiler" data-lesson-compiler aria-labelledby="compiler-title">
  <div class="compiler__chrome" aria-hidden="true">
    <span class="compiler__lights"><i></i><i></i><i></i></span>
    <code>georgewall://lesson-compiler</code>
    <span class="compiler__status"><i></i> analysers armed</span>
  </div>

  <div class="compiler__body">
    <header class="compiler__intro">
      <div>
        <p>Build output · live trace</p>
        <figcaption id="compiler-title">
          Ship the product. Encode the lesson.
        </figcaption>
      </div>
      <span class="compiler__branch">main <i aria-hidden="true">↗</i> protected</span>
    </header>

    <div class="compiler__flow">
      <section class="compiler__source" aria-labelledby="source-title">
        <div class="compiler__section-head">
          <span>01 / ship</span>
          <small>App Store</small>
        </div>
        <h2 id="source-title">Real products</h2>
        <ul>
          {
            products.map((product) => (
              <li>
                <i aria-hidden="true"></i>
                <strong>{product.name}</strong>
                <span>v{product.version}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="compiler__relay" aria-hidden="true">
        <span>ship</span>
        <div class="compiler__reactor">
          <i class="compiler__ring compiler__ring--outer"></i>
          <i class="compiler__ring compiler__ring--inner"></i>
          <i class="compiler__core"></i>
          <i class="compiler__packet compiler__packet--in"></i>
          <i class="compiler__packet compiler__packet--out"></i>
        </div>
        <span>learn</span>
      </div>

      <section class="compiler__guard" aria-labelledby="guard-title">
        <div class="compiler__section-head">
          <span>02 / encode</span>
          <small>NuGet</small>
        </div>
        <h2 id="guard-title">Reusable guardrail</h2>
        <div class="compiler__diagnostic">
          <span>active diagnostic</span>
          <code data-guard-code>{traceStages[0].diagnostic}</code>
          <strong data-guard-title>{traceStages[0].title}</strong>
        </div>
        <div class="compiler__rules" aria-label="Example analyser rules">
          <span>LINQ001</span>
          <span>DI0001</span>
          <span>CPM</span>
        </div>
      </section>
    </div>

    <section class="failure" aria-labelledby="failure-title">
      <div class="failure__heading">
        <div>
          <p>Failure distance</p>
          <h2 id="failure-title">Move the catch closer to the thought.</h2>
        </div>
        <span data-trace-title>{traceStages[0].title}</span>
      </div>

      <div class="failure__timeline">
        <div class="failure__rail" aria-hidden="true">
          <i></i>
          <span></span>
        </div>
        <div
          class="failure__controls"
          role="group"
          aria-label="Choose where the fault is caught"
        >
          {
            traceStages.map((stage, index) => (
              <button
                type="button"
                data-trace-step
                data-trace-index={index}
                data-trace-title={stage.title}
                data-trace-copy={stage.copy}
                data-trace-code={stage.diagnostic}
                data-trace-output={stage.output}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <i aria-hidden="true"></i>
                <span>{stage.code}</span>
                <strong>{stage.label}</strong>
              </button>
            ))
          }
        </div>
      </div>

      <div class="failure__readout">
        <p data-trace-copy-target>{traceStages[0].copy}</p>
        <code>
          <span aria-hidden="true">$</span>
          <span data-trace-output-target>{traceStages[0].output}</span>
          <strong aria-hidden="true">✓</strong>
        </code>
      </div>
    </section>
  </div>
</figure>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-lesson-compiler]")
    .forEach((compiler) => {
      const buttons = [
        ...compiler.querySelectorAll<HTMLButtonElement>("[data-trace-step]"),
      ];
      const traceTitle =
        compiler.querySelector<HTMLElement>("[data-trace-title]");
      const traceCopy =
        compiler.querySelector<HTMLElement>("[data-trace-copy-target]");
      const traceOutput =
        compiler.querySelector<HTMLElement>("[data-trace-output-target]");
      const guardCode =
        compiler.querySelector<HTMLElement>("[data-guard-code]");
      const guardTitle =
        compiler.querySelector<HTMLElement>("[data-guard-title]");
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let activeIndex = 0;
      let timer = 0;

      const select = (button: HTMLButtonElement) => {
        activeIndex = Number(button.dataset.traceIndex) || 0;
        buttons.forEach((candidate) =>
          candidate.setAttribute("aria-pressed", String(candidate === button)),
        );
        compiler.style.setProperty("--trace-index", String(activeIndex));
        if (traceTitle) traceTitle.textContent = button.dataset.traceTitle ?? "";
        if (traceCopy) traceCopy.textContent = button.dataset.traceCopy ?? "";
        if (traceOutput)
          traceOutput.textContent = button.dataset.traceOutput ?? "";
        if (guardCode) guardCode.textContent = button.dataset.traceCode ?? "";
        if (guardTitle) guardTitle.textContent = button.dataset.traceTitle ?? "";
      };

      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        if (reduceMotion || buttons.length < 2 || document.hidden) return;
        timer = window.setInterval(() => {
          select(buttons[(activeIndex + 1) % buttons.length]);
        }, 2700);
      };

      buttons.forEach((button) =>
        button.addEventListener("click", () => {
          select(button);
          start();
        }),
      );
      compiler.addEventListener("pointerenter", stop);
      compiler.addEventListener("pointerleave", start);
      compiler.addEventListener("focusin", stop);
      compiler.addEventListener("focusout", (event) => {
        if (!compiler.contains(event.relatedTarget as Node | null)) start();
      });
      document.addEventListener("visibilitychange", () =>
        document.hidden ? stop() : start(),
      );
      start();
    });
</script>

<style>
  .compiler {
    --trace-index: 0;
    --console-bg: #080b10;
    --console-panel: #101620;
    --console-panel-strong: #151e2a;
    --console-ink: #f5f1e8;
    --console-soft: #a5afbd;
    --console-faint: #6e7a8c;
    --console-rule: #283446;
    --console-fault: #ff6542;
    --console-fix: #62c4ff;
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid #38465a;
    border-radius: 16px;
    color: var(--console-ink);
    background: var(--console-bg);
    box-shadow:
      0 2.8rem 7rem rgb(0 0 0 / 0.42),
      0 0 0 1px rgb(255 255 255 / 0.025) inset,
      0 1px 0 rgb(255 255 255 / 0.08) inset;
    isolation: isolate;
  }

  .compiler::before,
  .compiler::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .compiler::before {
    inset: 2.8rem 0 0;
    opacity: 0.4;
    background-image:
      linear-gradient(rgb(98 196 255 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(98 196 255 / 0.055) 1px, transparent 1px);
    background-size: 2.4rem 2.4rem;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
  }

  .compiler::after {
    inset: -25% -10% 18% 38%;
    background:
      radial-gradient(circle at 65% 30%, rgb(98 196 255 / 0.13), transparent 33%),
      radial-gradient(circle at 22% 72%, rgb(255 101 66 / 0.13), transparent 30%);
    filter: blur(22px);
  }

  .compiler__chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 2.8rem;
    padding-inline: 1rem;
    border-bottom: 1px solid var(--console-rule);
    color: var(--console-faint);
    background: rgb(255 255 255 / 0.025);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.07em;
  }

  .compiler__lights {
    display: flex;
    gap: 0.35rem;
  }

  .compiler__lights i {
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid var(--console-rule);
    border-radius: 50%;
  }

  .compiler__lights i:first-child {
    border-color: var(--console-fault);
    background: rgb(255 101 66 / 0.24);
  }

  .compiler__status {
    display: inline-flex;
    justify-self: end;
    align-items: center;
    gap: 0.42rem;
    text-transform: uppercase;
  }

  .compiler__status i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--console-fix);
    box-shadow: 0 0 0.75rem var(--console-fix);
    animation: compiler-status 2.2s ease-in-out infinite;
  }

  .compiler__body {
    padding: clamp(1rem, 2.2vw, 1.45rem);
  }

  .compiler__intro,
  .compiler__section-head,
  .failure__heading,
  .failure__readout {
    display: flex;
    align-items: center;
  }

  .compiler__intro {
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
  }

  .compiler__intro p,
  .compiler__section-head,
  .failure__heading p {
    color: var(--console-fix);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .compiler figcaption {
    margin-top: 0.24rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.25vw, 1.8rem);
    font-variation-settings: "opsz" 56, "WONK" 0, "wght" 540;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .compiler__branch {
    flex: none;
    padding: 0.42rem 0.58rem;
    border: 1px solid var(--console-rule);
    border-radius: 999px;
    color: var(--console-soft);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .compiler__branch i {
    color: var(--console-fix);
    font-style: normal;
  }

  .compiler__flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(4.1rem, 8vw, 5.6rem) minmax(0, 1fr);
    align-items: stretch;
    min-height: 12.8rem;
    border-block: 1px solid var(--console-rule);
  }

  .compiler__source,
  .compiler__guard {
    min-width: 0;
    padding: 1rem;
    background: linear-gradient(145deg, rgb(255 255 255 / 0.035), transparent 60%);
  }

  .compiler__source {
    border-left: 2px solid var(--console-fault);
  }

  .compiler__guard {
    border-right: 2px solid var(--console-fix);
  }

  .compiler__section-head {
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--console-fault);
  }

  .compiler__guard .compiler__section-head {
    color: var(--console-fix);
  }

  .compiler__section-head small {
    color: var(--console-faint);
    font-size: inherit;
    letter-spacing: 0.08em;
  }

  .compiler__source h2,
  .compiler__guard h2 {
    margin-top: 0.48rem;
    color: var(--console-ink);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-variation-settings: "wght" 620;
    line-height: 1.1;
  }

  .compiler__source ul {
    margin-top: 0.85rem;
    list-style: none;
  }

  .compiler__source li {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.05rem;
    border-top: 1px solid var(--console-rule);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .compiler__source li:last-child {
    border-bottom: 1px solid var(--console-rule);
  }

  .compiler__source li i {
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid var(--console-fault);
    border-radius: 50%;
    background: rgb(255 101 66 / 0.1);
  }

  .compiler__source li strong {
    overflow-wrap: anywhere;
    font-weight: 560;
  }

  .compiler__source li span {
    color: var(--console-faint);
  }

  .compiler__relay {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    place-items: center;
    overflow: hidden;
    border-inline: 1px solid var(--console-rule);
    background: rgb(0 0 0 / 0.18);
  }

  .compiler__relay::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    content: "";
    background: linear-gradient(var(--console-fault), var(--console-rule) 48%, var(--console-fix));
  }

  .compiler__relay > span {
    position: relative;
    z-index: 2;
    align-self: center;
    padding: 0.25rem;
    color: var(--console-faint);
    background: var(--console-bg);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .compiler__reactor {
    position: relative;
    z-index: 2;
    width: 3.1rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--console-bg);
  }

  .compiler__ring,
  .compiler__core,
  .compiler__packet {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .compiler__ring {
    border: 1px solid var(--console-rule);
  }

  .compiler__ring--outer {
    width: 100%;
    height: 100%;
    border-color: rgb(98 196 255 / 0.4);
    border-top-color: var(--console-fault);
    animation: reactor-spin 5s linear infinite;
  }

  .compiler__ring--inner {
    width: 66%;
    height: 66%;
    border-color: rgb(255 101 66 / 0.38);
    border-bottom-color: var(--console-fix);
    animation: reactor-spin 3.2s linear infinite reverse;
  }

  .compiler__core {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--console-ink);
    box-shadow:
      0 0 0.8rem var(--console-fix),
      0 0 1.8rem rgb(98 196 255 / 0.55);
    animation: reactor-core 1.6s ease-in-out infinite;
  }

  .compiler__packet {
    left: 50%;
    width: 0.34rem;
    height: 0.34rem;
  }

  .compiler__packet--in {
    background: var(--console-fault);
    animation: packet-in 2.8s var(--ease) infinite;
  }

  .compiler__packet--out {
    background: var(--console-fix);
    box-shadow: 0 0 0.6rem var(--console-fix);
    animation: packet-out 2.8s var(--ease) infinite;
  }

  .compiler__diagnostic {
    position: relative;
    min-height: 5.2rem;
    margin-top: 0.85rem;
    padding: 0.72rem;
    overflow: hidden;
    border: 1px solid rgb(98 196 255 / 0.36);
    border-radius: 5px;
    background:
      linear-gradient(125deg, rgb(98 196 255 / 0.11), transparent 65%),
      var(--console-panel);
  }

  .compiler__diagnostic::after {
    position: absolute;
    top: -30%;
    bottom: -30%;
    width: 35%;
    content: "";
    background: linear-gradient(90deg, transparent, rgb(98 196 255 / 0.13), transparent);
    transform: skewX(-18deg);
    animation: diagnostic-scan 4.2s ease-in-out infinite;
  }

  .compiler__diagnostic span,
  .compiler__diagnostic code,
  .compiler__diagnostic strong {
    position: relative;
    z-index: 1;
    display: block;
  }

  .compiler__diagnostic span {
    color: var(--console-faint);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .compiler__diagnostic code {
    margin-top: 0.28rem;
    color: var(--console-fix);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.8vw, 1.16rem);
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .compiler__diagnostic strong {
    margin-top: 0.12rem;
    color: var(--console-soft);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 520;
  }

  .compiler__rules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.62rem;
  }

  .compiler__rules span {
    padding: 0.25rem 0.38rem;
    border: 1px solid var(--console-rule);
    border-radius: 3px;
    color: var(--console-soft);
    font-family: var(--font-mono);
    font-size: 0.48rem;
  }

  .failure {
    margin-top: 1rem;
    padding: 0.85rem;
    border: 1px solid var(--console-rule);
    border-radius: 7px;
    background: color-mix(in srgb, var(--console-panel) 84%, transparent);
    font-family: var(--font-mono);
  }

  .failure__heading {
    justify-content: space-between;
    gap: 1rem;
  }

  .failure__heading h2 {
    margin-top: 0.2rem;
    color: var(--console-soft);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-variation-settings: "wght" 470;
  }

  .failure__heading [data-trace-title] {
    color: var(--console-ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-variation-settings: "opsz" 36, "WONK" 0, "wght" 560;
    line-height: 1;
    text-align: right;
  }

  .failure__timeline {
    position: relative;
    margin-top: 0.8rem;
  }

  .failure__rail {
    position: absolute;
    top: 1.13rem;
    right: 10%;
    left: 10%;
    height: 2px;
    overflow: visible;
    background: var(--console-rule);
  }

  .failure__rail i {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--console-fault), var(--console-fix));
    transform: scaleX(calc((var(--trace-index) + 0.18) / 4.18));
    transform-origin: 0 50%;
    transition: transform 0.65s var(--ease);
  }

  .failure__rail span {
    position: absolute;
    top: 50%;
    left: calc(var(--trace-index) * 25%);
    width: 0.58rem;
    height: 0.58rem;
    border: 2px solid var(--console-ink);
    border-radius: 50%;
    background: color-mix(in srgb, var(--console-fault) calc((4 - var(--trace-index)) * 25%), var(--console-fix));
    box-shadow: 0 0 0.75rem var(--console-fix);
    transform: translate(-50%, -50%);
    transition:
      left 0.65s var(--ease),
      background 0.4s ease;
  }

  .failure__controls {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .failure__controls button {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    min-height: 3.45rem;
    padding: 0;
    border: 0;
    color: var(--console-faint);
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .failure__controls button i {
    width: 0.48rem;
    height: 0.48rem;
    margin-top: 0.9rem;
    border: 1px solid var(--console-faint);
    border-radius: 50%;
    background: var(--console-panel);
    transition:
      border-color 0.3s ease,
      background 0.3s ease,
      transform 0.3s var(--ease);
  }

  .failure__controls button span {
    margin-top: 0.48rem;
    font-size: 0.46rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .failure__controls button strong {
    margin-top: 0.12rem;
    font-size: 0.5rem;
    font-weight: 520;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .failure__controls button[aria-pressed="true"] {
    color: var(--console-ink);
  }

  .failure__controls button[aria-pressed="true"] i {
    border-color: var(--console-ink);
    background: var(--console-fix);
    box-shadow: 0 0 0.65rem rgb(98 196 255 / 0.6);
    transform: scale(1.2);
  }

  .failure__readout {
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.55rem;
    margin-top: 0.42rem;
    padding-top: 0.68rem;
    border-top: 1px solid var(--console-rule);
  }

  .failure__readout p {
    max-width: 54ch;
    color: var(--console-soft);
    font-family: var(--font-sans);
    font-size: 0.61rem;
    line-height: 1.38;
  }

  .failure__readout code {
    flex: none;
    color: var(--console-soft);
    font-family: inherit;
    font-size: 0.51rem;
    white-space: nowrap;
  }

  .failure__readout code > span:first-child {
    color: var(--console-fault);
  }

  .failure__readout code strong {
    color: var(--console-fix);
  }

  @keyframes compiler-status {
    50% {
      opacity: 0.55;
      box-shadow: 0 0 0.25rem var(--console-fix);
    }
  }

  @keyframes reactor-spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes reactor-core {
    50% {
      transform: translate(-50%, -50%) scale(1.35);
    }
  }

  @keyframes packet-in {
    0%,
    22% {
      top: -2.9rem;
      opacity: 0;
    }
    45% {
      top: 50%;
      opacity: 1;
    }
    58%,
    100% {
      top: 50%;
      opacity: 0;
    }
  }

  @keyframes packet-out {
    0%,
    52% {
      top: 50%;
      opacity: 0;
    }
    66% {
      opacity: 1;
    }
    88%,
    100% {
      top: calc(100% + 2.9rem);
      opacity: 0;
    }
  }

