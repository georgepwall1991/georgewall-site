---
const productLane = [
  { name: "NoBooze", version: "1.6.1", state: "live" },
  { name: "GemGame", version: "2.1.6", state: "live" },
  { name: "Fleet Commander", version: "1.0.5", state: "live" },
];

const toolingLane = [
  { name: "LinqContraband", version: "5.7.52", state: "armed" },
  { name: "DI Lifetimes", version: "3.7.4", state: "armed" },
  { name: "CPMigrate", version: "3.56.0", state: "ready" },
];

const traceStages = [
  {
    code: "days",
    label: "Production",
    title: "A user finds it.",
    copy: "Worst case: it is live, someone is blocked and the useful context has gone.",
    output: "user report → triage",
  },
  {
    code: "hours",
    label: "Runtime",
    title: "The system spots it.",
    copy: "Logs narrow it down, but the broken code is already running.",
    output: "stack trace → isolate",
  },
  {
    code: "minutes",
    label: "Tests",
    title: "A test catches it.",
    copy: "Better. It is caught before release, with enough evidence to reproduce it.",
    output: "red test → reproduce",
  },
  {
    code: "seconds",
    label: "Build",
    title: "The build rejects it.",
    copy: "Turn the lesson into a rule and the same mistake stops at build time.",
    output: "LINQ001 → build blocked",
  },
  {
    code: "now",
    label: "Editor",
    title: "I fix it as I type.",
    copy: "The analyser flags the line while I still remember why I wrote it.",
    output: "LINQ001 → quick fix ready",
  },
];
---

<figure class="console" data-trace-deck aria-labelledby="console-title">
  <header class="console__top">
    <div>
      <p class="console__eyebrow">Build output</p>
      <figcaption id="console-title">I ship products. Then I turn the problems I find into tools.</figcaption>
    </div>
    <span class="console__branch"><i aria-hidden="true"></i> main · tracing</span>
  </header>

  <div class="console__matrix">
    <section
      class="console__lane console__lane--product"
      aria-labelledby="product-lane-title"
    >
      <div class="console__lane-head">
        <div>
          <span aria-hidden="true">A</span>
          <h2 id="product-lane-title">Products I ship</h2>
        </div>
        <small>App Store</small>
      </div>
      <ul>
        {
          productLane.map((item) => (
            <li>
              <span class="console__node" aria-hidden="true"></span>
              <strong>{item.name}</strong>
              <span>v{item.version}</span>
              <small>{item.state}</small>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="console__bus" aria-hidden="true">
      <span class="console__bus-label">what broke</span>
      <div class="console__bus-track">
        <i class="console__bus-node console__bus-node--top"></i>
        <i class="console__bus-signal"></i>
        <i class="console__bus-node console__bus-node--bottom"></i>
      </div>
      <span class="console__bus-turn">fix it once</span>
    </div>

    <section
      class="console__lane console__lane--tooling"
      aria-labelledby="tooling-lane-title"
    >
      <div class="console__lane-head">
        <div>
          <span aria-hidden="true">B</span>
          <h2 id="tooling-lane-title">Tools I build</h2>
        </div>
        <small>NuGet</small>
      </div>
      <ul>
        {
          toolingLane.map((item) => (
            <li>
              <span class="console__node" aria-hidden="true"></span>
              <strong>{item.name}</strong>
              <span>v{item.version}</span>
              <small>{item.state}</small>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <section class="trace" aria-labelledby="trace-title">
    <div class="trace__head">
      <p id="trace-title">Where the bug gets caught</p>
      <output data-trace-title aria-live="polite">{traceStages[0].title}</output>
    </div>

    <div
      class="trace__controls"
      role="group"
      aria-label="Choose where the bug gets caught"
    >
      {
        traceStages.map((stage, index) => (
          <button
            type="button"
            data-trace-step
            data-trace-index={index}
            data-trace-title={stage.title}
            data-trace-copy={stage.copy}
            data-trace-output={stage.output}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span>{stage.code}</span>
            {stage.label}
          </button>
        ))
      }
    </div>

    <div class="trace__rail" aria-hidden="true">
      <i></i>
      <span></span>
    </div>

    <div class="trace__readout">
      <p data-trace-copy>{traceStages[0].copy}</p>
      <code>
        <span aria-hidden="true">$</span>
        <span data-trace-output>{traceStages[0].output}</span>
        <strong>✓</strong>
      </code>
    </div>
  </section>

  <div class="console__result">
    <span>trace://georgewall/production</span>
    <code>idea → build → ship → learn → fix</code>
    <strong>same bug, caught sooner</strong>
  </div>
</figure>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-trace-deck]")
    .forEach((deck) => {
      const buttons = [
        ...deck.querySelectorAll<HTMLButtonElement>("[data-trace-step]"),
      ];
      const title = deck.querySelector<HTMLOutputElement>(
        "[data-trace-title]",
      );
      const copy = deck.querySelector<HTMLElement>("[data-trace-copy]");
      const output = deck.querySelector<HTMLElement>("[data-trace-output]");

      const select = (button: HTMLButtonElement) => {
        buttons.forEach((candidate) =>
          candidate.setAttribute("aria-pressed", String(candidate === button)),
        );
        const index = Number(button.dataset.traceIndex) || 0;
        deck.style.setProperty("--trace-offset", `${index * 100}%`);
        deck.style.setProperty("--trace-position", `${index * 20 + 10}%`);
        if (title) title.textContent = button.dataset.traceTitle ?? "";
        if (copy) copy.textContent = button.dataset.traceCopy ?? "";
        if (output) output.textContent = button.dataset.traceOutput ?? "";
      };

      buttons.forEach((button) =>
        button.addEventListener("click", () => select(button)),
      );
    });
</script>

<style>
  .console {
    --trace-offset: 0%;
    --trace-position: 10%;
    position: relative;
    margin: 0;
    overflow: hidden;
    padding: clamp(1rem, 2.2vw, 1.55rem);
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background:
      linear-gradient(145deg, var(--fix-wash), transparent 32%),
      linear-gradient(325deg, var(--fault-wash), transparent 30%),
      var(--paper-raised);
    box-shadow:
      0 1.8rem 5.5rem rgb(0 0 0 / 0.34),
      inset 0 1px 0 rgb(255 255 255 / 0.035);
    isolation: isolate;
  }

  .console::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    opacity: 0.34;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 2.2rem 2.2rem;
    mask-image: linear-gradient(to bottom, black, transparent 91%);
  }

  .console::after {
    position: absolute;
    inset: -30% 52% 35% -18%;
    z-index: -1;
    content: "";
    pointer-events: none;
    background: radial-gradient(circle, var(--fault-wash), transparent 68%);
    filter: blur(14px);
  }

  .console__top,
  .console__lane-head,
  .console__lane-head > div,
  .console__lane li,
  .trace__head,
  .console__result {
    display: flex;
    align-items: center;
  }

  .console__top {
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .console__eyebrow,
  .console__branch,
  .console__lane,
  .trace,
  .console__result {
    font-family: var(--font-mono);
  }

  .console__eyebrow {
    margin-bottom: 0.28rem;
    color: var(--fix);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .console figcaption {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.72rem);
    font-variation-settings: "opsz" 48, "WONK" 0, "wght" 500;
    line-height: 1.08;
  }

  .console__branch {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: 0.45rem;
    color: var(--ink-soft);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .console__branch i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--fix);
    box-shadow: 0 0 0 0 var(--fix);
    animation: console-pulse 2.4s ease-out infinite;
  }

  .console__matrix {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: stretch;
    padding-block: clamp(1rem, 2.5vw, 1.45rem);
  }

  .console__lane {
    min-width: 0;
    padding: 0.78rem;
    border: 1px solid var(--rule-strong);
    border-radius: 5px;
    background: color-mix(in srgb, var(--paper-sunk) 89%, transparent);
  }

  .console__lane--product {
    box-shadow: inset -3px 0 0 color-mix(in srgb, var(--fault) 72%, transparent);
  }

  .console__lane--tooling {
    box-shadow: inset 3px 0 0 color-mix(in srgb, var(--fix) 72%, transparent);
  }

  .console__lane-head {
    justify-content: space-between;
    gap: 0.55rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--rule);
  }

  .console__lane-head > div {
    min-width: 0;
    gap: 0.5rem;
  }

  .console__lane-head span {
    color: var(--fault);
    font-size: 0.57rem;
  }

  .console__lane--tooling .console__lane-head span {
    color: var(--fix);
  }

  .console__lane-head h2 {
    overflow: hidden;
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 610;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .console__lane-head small {
    flex: none;
    color: var(--ink-faint);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .console__lane ul {
    list-style: none;
  }

  .console__lane li {
    display: grid;
    grid-template-columns: 0.62rem minmax(0, 1fr) auto;
    gap: 0.45rem;
    padding: 0.57rem 0;
    color: var(--ink-soft);
    font-size: 0.62rem;
  }

  .console__lane li + li {
    border-top: 1px solid var(--rule);
  }

  .console__lane li strong {
    overflow: hidden;
    color: var(--ink);
    font-weight: 530;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .console__lane li > span:not(.console__node) {
    color: var(--ink-faint);
  }

  .console__lane li small {
    display: none;
  }

  .console__node {
    align-self: center;
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid var(--fault);
    border-radius: 50%;
    background: var(--fault-wash);
  }

  .console__lane--tooling .console__node {
    border-color: var(--fix);
    background: var(--fix-wash);
  }

  .console__bus {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
  }

  .console__bus-track {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 50%;
    width: 1px;
    background: linear-gradient(var(--fault), var(--rule-strong) 48%, var(--fix));
  }

  .console__bus-node,
  .console__bus-signal {
    position: absolute;
    left: 50%;
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .console__bus-node--top {
    top: 0;
    border: 1px solid var(--fault);
    background: var(--paper-sunk);
  }

  .console__bus-node--bottom {
    top: 100%;
    border: 1px solid var(--fix);
    background: var(--paper-sunk);
  }

  .console__bus-signal {
    top: 0;
    background: var(--ink);
    box-shadow: 0 0 0.7rem var(--fix);
    animation: trace-route 3.8s var(--ease) infinite;
  }

  .console__bus-label,
  .console__bus-turn {
    position: absolute;
    left: 50%;
    width: max-content;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateX(-50%) rotate(-90deg);
  }

  .console__bus-label {
    top: 24%;
  }

  .console__bus-turn {
    bottom: 28%;
  }

  .trace {
    padding: 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 5px;
    background: color-mix(in srgb, var(--paper-sunk) 92%, transparent);
  }

  .trace__head {
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.72rem;
  }

  .trace__head p {
    flex: none;
    color: var(--ink-faint);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .trace__head output {
    overflow: hidden;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.65vw, 1.18rem);
    font-variation-settings: "opsz" 42, "WONK" 0, "wght" 500;
    line-height: 1.15;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .trace__controls {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .trace__controls button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 0;
    min-height: 38px;
    padding: 0.45rem;
    border: 0;
    color: var(--ink-faint);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .trace__controls button + button {
    border-left: 1px solid var(--rule);
  }

  .trace__controls button span {
    color: var(--ink-faint);
    font-size: 0.46rem;
  }

  .trace__controls button:hover,
  .trace__controls button[aria-pressed="true"] {
    color: var(--ink);
  }

  .trace__controls button[aria-pressed="true"] span {
    color: var(--fault);
  }

  .trace__controls button:nth-child(n + 4)[aria-pressed="true"] span {
    color: var(--fix);
  }

  .trace__rail {
    position: relative;
    height: 3px;
    background: var(--rule);
  }

  .trace__rail i {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(100% / 5);
    background: linear-gradient(90deg, var(--fault), var(--fix));
    transform: translateX(var(--trace-offset));
    transition: transform 0.5s var(--ease);
  }

  .trace__rail span {
    position: absolute;
    top: 50%;
    left: var(--trace-position);
    width: 0.48rem;
    height: 0.48rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper-sunk);
    transform: translate(-50%, -50%);
    transition: left 0.5s var(--ease);
  }

  .trace__readout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: end;
    padding-top: 0.78rem;
  }

  .trace__readout p {
    max-width: 49ch;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    line-height: 1.48;
  }

  .trace__readout code {
    color: var(--ink-soft);
    font-size: 0.58rem;
    white-space: nowrap;
  }

  .trace__readout code > span:first-child {
    color: var(--fault);
  }

  .trace__readout strong {
    color: var(--fix);
    font-weight: 500;
  }

  .console__result {
    gap: 0.65rem;
    padding-top: 0.8rem;
    color: var(--ink-faint);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
  }

  .console__result > span {
    color: var(--fix);
  }

  .console__result code {
    min-width: 0;
    overflow: hidden;
    color: var(--ink-soft);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .console__result strong {
    margin-left: auto;
    color: var(--fix);
    font-weight: 500;
    white-space: nowrap;
  }

  @keyframes console-pulse {
    70% {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }

  @keyframes trace-route {
    0%,
    14% {
      top: 0;
      background: var(--fault);
      box-shadow: 0 0 0.7rem var(--fault);
    }
    48%,
    62% {
      top: 50%;
      background: var(--ink);
      box-shadow: 0 0 0.7rem var(--ink);
    }
    92%,
    100% {
      top: 100%;
      background: var(--fix);
      box-shadow: 0 0 0.7rem var(--fix);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .console__branch i,
    .console__bus-signal {
      animation: none;
    }

    .console__bus-signal {
      top: 50%;
    }

    .trace__rail i,
    .trace__rail span {
      transition: none;
    }
  }

  @media (max-width: 560px) {
    .console {
      padding: 0.9rem;
    }

    .console__branch,
    .console__result strong {
      display: none;
    }

    .console__matrix {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .console__bus {
      min-height: 2.8rem;
    }

    .console__bus-track {
      top: 50%;
      right: 1.2rem;
      bottom: auto;
      left: 1.2rem;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--fault), var(--rule-strong), var(--fix));
    }

    .console__bus-node,
    .console__bus-signal {
      top: 50%;
    }

    .console__bus-node--top {
      left: 0;
    }

    .console__bus-node--bottom {
      left: 100%;
    }

    .console__bus-signal {
      left: 50%;
      animation: none;
    }

    .console__bus-label,
    .console__bus-turn {
      top: auto;
      bottom: 0;
      transform: translateX(-50%);
    }

    .console__bus-label {
      left: 28%;
    }

    .console__bus-turn {
      left: 72%;
    }

    .trace__head {
      display: block;
    }

    .trace__head output {
      display: block;
      margin-top: 0.4rem;
      text-align: left;
      white-space: normal;
    }

    .trace__controls button {
      min-height: 44px;
      padding-inline: 0.2rem;
      font-size: 0.49rem;
    }

    .trace__controls button span {
      display: none;
    }

    .trace__readout {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .trace__readout code {
      white-space: normal;
    }

    .console__result > span {
      display: none;
    }
  }
</style>
