---
import type { PrivateApp } from '../data/apps';

interface Props {
  apps: PrivateApp[];
}

const { apps } = Astro.props;
---

<section class="apps" id="apps" aria-labelledby="apps-title">
  <div class="wrap">
    <header class="apps__head reveal">
      <p class="kicker">Private apps</p>
      <h2 class="display apps__title" id="apps-title">iOS games that made it past the README.</h2>
      <p class="apps__intro">
        Not every useful build belongs in a public repo. This is the product end of the
        work: screenshots, store copy, Game Center, monetisation, release notes, and all
        the dull bits between “it runs” and “someone can actually download it”.
      </p>
    </header>

    <div class="apps__grid">
      {
        apps.map((app, index) => (
          <article class="app reveal" style={`--reveal-delay:${index * 90}ms`}>
            <div class={`app__media app__media--${app.screenshots.length === 1 ? 'icon' : 'screens'}`}>
              {app.screenshots.map((shot, shotIndex) => (
                <figure class={`phone phone--${shotIndex + 1}`}>
                  <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>

            <div class="app__body">
              <p class="app__kicker">{app.kicker}</p>
              <div class="app__titleRow">
                <h3 class="app__title">{app.title}</h3>
                <span class="app__status">{app.status}</span>
              </div>
              <p class="app__blurb">{app.blurb}</p>
              <ul class="app__stack" aria-label={`${app.title} stack`}>
                {app.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {
                app.url && (
                  <a class="app__cta link link--on" href={app.url} target="_blank" rel="noopener">
                    {app.cta ?? 'Open'} <span aria-hidden="true">↗</span>
                  </a>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .apps {
    padding-top: clamp(4.5rem, 9vw, 8rem);
  }

  .apps__head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.55fr);
    gap: clamp(1.5rem, 6vw, 5rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(1.3rem, 3vw, 2rem);
    border-bottom: 1.5px solid var(--ink);
  }

  .apps__title {
    grid-column: 1;
    font-size: clamp(2.3rem, 5.4vw, 4.8rem);
    max-width: 14ch;
    margin-top: 0.75rem;
  }

  .apps__intro {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.25vw, 1.16rem);
    line-height: 1.55;
    max-width: 38ch;
  }

  .apps__grid {
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }

  .app {
    display: grid;
    grid-template-columns: minmax(18rem, 0.74fr) minmax(0, 1fr);
    gap: clamp(1.2rem, 4vw, 3.2rem);
    align-items: stretch;
    padding: clamp(1rem, 2.4vw, 1.8rem);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    background:
      linear-gradient(135deg, var(--paper-raised), var(--paper) 58%),
      var(--paper-raised);
    box-shadow: 6px 7px 0 var(--ink);
  }

  .app__media {
    min-height: clamp(20rem, 42vw, 31rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    gap: 0.9rem;
    overflow: hidden;
    border-radius: 6px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 14%, transparent), transparent 45%),
      var(--paper-sunk);
    padding: clamp(0.9rem, 2.6vw, 1.5rem);
  }

  .app__media--icon {
    grid-template-columns: 1fr;
    min-height: clamp(14rem, 26vw, 22rem);
  }

  .phone {
    width: min(100%, 13.2rem);
    aspect-ratio: 9 / 19.5;
    border: 0.48rem solid var(--ink);
    border-radius: 1.75rem;
    overflow: hidden;
    background: #050505;
    box-shadow: 0 1.2rem 2.5rem rgba(0, 0, 0, 0.24);
  }

  .phone--2 {
    transform: translateY(1.6rem);
  }

  .app__media--icon .phone {
    width: min(78%, 14rem);
    aspect-ratio: 1;
    border-width: 0.28rem;
    border-radius: 2rem;
    background: var(--paper-raised);
  }

  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .app__media--icon .phone img {
    object-fit: contain;
  }

  .app__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    min-width: 0;
    padding-block: 0.4rem;
  }

  .app__kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .app__titleRow {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.9rem;
  }

  .app__title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 70, 'WONK' 1, 'wght' 560;
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .app__status {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    border-radius: 999px;
    padding: 0.45em 0.75em;
    margin-top: 0.2rem;
    white-space: nowrap;
  }

  .app__blurb {
    max-width: 54ch;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.4vw, 1.16rem);
    line-height: 1.55;
  }

  .app__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .app__stack li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.3rem 0.58rem;
    background: color-mix(in srgb, var(--paper-raised) 72%, transparent);
  }

  .app__cta {
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    margin-top: 0.3rem;
  }

  @media (max-width: 980px) {
    .apps__head,
    .app {
      grid-template-columns: 1fr;
    }

    .apps__intro {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 620px) {
    .app__media {
      min-height: 25rem;
      padding: 0.85rem;
      gap: 0.55rem;
    }

    .phone {
      border-width: 0.34rem;
      border-radius: 1.35rem;
    }

    .app__titleRow {
      display: grid;
    }

    .app__status {
      width: fit-content;
    }
  }
</style>
