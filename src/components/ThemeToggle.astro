---
// Light/dark toggle. Theme is resolved pre-paint in Base.astro; this just flips
// and persists the choice.
---

<button class="theme-toggle" type="button" aria-label="Switch to light colour theme" aria-pressed="false" title="Switch to light colour theme">
  <span class="theme-toggle__track">
    <span class="theme-toggle__thumb"></span>
  </span>
  <span class="theme-toggle__label" data-label-light="Light" data-label-dark="Dark">Light</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2em;
  }

  .theme-toggle__track {
    position: relative;
    width: 2.5em;
    height: 1.25em;
    border: 1.5px solid var(--rule-strong);
    border-radius: 999px;
    transition: border-color 0.3s ease;
  }

  .theme-toggle__thumb {
    position: absolute;
    top: 50%;
    left: 0.18em;
    width: 0.78em;
    height: 0.78em;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-50%);
    transition: transform 0.35s var(--ease), background 0.3s ease;
  }

  /* Dark (default) parks the thumb right; light slides it home. */
  :global(:root:not([data-theme='light'])) .theme-toggle__thumb {
    transform: translate(1.2em, -50%);
  }

  .theme-toggle:hover .theme-toggle__track {
    border-color: var(--accent);
  }

  .theme-toggle__label {
    min-width: 2.6em;
    text-align: left;
  }

  @media (max-width: 620px) {
    .theme-toggle__label {
      display: none;
    }
    /* Label is hidden, so the track alone is only ~18px tall — too small to
       tap. Expand the button to a 44px minimum hit area (track stays centered). */
    .theme-toggle {
      min-width: 44px;
      min-height: 44px;
      justify-content: center;
      padding: 0.5em;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const label = btn?.querySelector<HTMLElement>('.theme-toggle__label');

  function syncLabel() {
    const theme = document.documentElement.dataset.theme ?? 'light';
    const isDark = theme === 'dark';
    if (label) label.textContent = isDark ? label.dataset.labelDark! : label.dataset.labelLight!;
    if (btn) {
      const action = isDark ? 'Switch to light colour theme' : 'Switch to dark colour theme';
      btn.setAttribute('aria-label', action);
      btn.setAttribute('title', action);
      btn.setAttribute('aria-pressed', String(isDark));
    }
  }

  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      document.documentElement.dataset.theme = next;
      syncLabel();
    };
    try {
      localStorage.setItem('atlas-theme', next);
    } catch (_) {
      /* private mode — ignore */
    }

    // Circular wipe from the switch (View Transitions, progressive enhancement).
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduce) {
      apply();
      return;
    }
    const root = document.documentElement;
    const rect = btn!.getBoundingClientRect();
    root.style.setProperty('--vt-x', `${rect.left + rect.width / 2}px`);
    root.style.setProperty('--vt-y', `${rect.top + rect.height / 2}px`);
    root.classList.add('theme-vt');
    const vt = document.startViewTransition(apply);
    vt.finished.finally(() => root.classList.remove('theme-vt'));
  });

  syncLabel();
</script>
