<script>
  document.querySelectorAll<HTMLElement>("[data-code-fix]").forEach((proof) => {
    const button = proof.querySelector<HTMLButtonElement>("[data-code-fix-toggle]");
    if (!button) return;

    button.addEventListener("click", () => {
      const fixed = proof.dataset.fixed !== "true";
      proof.dataset.fixed = String(fixed);
      button.setAttribute("aria-pressed", String(fixed));
      const diagnostic = proof
        .closest<HTMLElement>(".entry")
        ?.querySelector<HTMLElement>(".entry__rail > span:not(.entry__rail-signal)")
        ?.textContent?.trim();
      button.setAttribute(
        "aria-label",
        fixed
          ? `Revert quick-fix preview for ${diagnostic ?? "diagnostic"}`
          : `Apply quick fix for ${diagnostic ?? "diagnostic"}`,
      );
    });
  });
</script>
