---
import type { Repo } from "../data/github";
import type { NuGetPackage } from "../data/nuget";
import type { ProjectProof } from "../data/featured";
import { languageColor, formatCount, relativeTime, pad2 } from "../lib/format";

interface Props {
  index: number;
  kicker: string;
  title: string;
  blurb: string;
  repo?: Repo;
  primary?: { label: string; href: string };
  package?: NuGetPackage;
  proof?: ProjectProof;
  anchor: string;
}
const {
  index,
  kicker,
  title,
  blurb,
  repo,
  primary,
  package: nuget,
  proof,
  anchor,
} = Astro.props;

// Destinations are editorially explicit. Deduping prevents a GitHub homepage
// from producing two differently-labelled links to the same place.
const links: { href: string; label: string }[] = [];
if (primary) links.push(primary);
if (repo) links.push({ href: repo.html_url, label: "GitHub" });
const uniqueLinks = [
  ...new Map(
    links.map((link) => [link.href.replace(/\/$/, ""), link]),
  ).values(),
];

const primaryHref = uniqueLinks[0]?.href ?? repo?.html_url ?? "#";
const topics = (repo?.topics ?? []).slice(0, 6);
const now = new Date();
---

<article class="entry reveal" id={anchor}>
  <div
    class="entry__rail"
    aria-label={proof ? `Diagnostic ${proof.diagnostic}` : `Project ${index}`}
  >
    <span class="entry__rail-signal" aria-hidden="true"></span>
    <span>{proof?.diagnostic ?? pad2(index)}</span>
    <small>{proof ? "diagnostic" : "selected work"}</small>
  </div>

  <div class="entry__body">
    <p class="kicker entry__kicker">{kicker}</p>

    <h3 class="entry__title">
      <a
        href={primaryHref}
        target="_blank"
        rel="noopener"
        class="link link--on entry__title-link"
      >
        {title}
      </a>
    </h3>

    <p class="entry__blurb">{blurb}</p>

    {
      proof && (
        <div
          class="entry__proof"
          data-code-fix
          data-fixed="false"
          aria-label={`${title} interactive diagnostic example`}
        >
          <div class="entry__proof-chrome" aria-hidden="true">
            <span class="entry__window-dots"><i></i><i></i><i></i></span>
            <code>{proof.file}:{proof.line}</code>
            <span>Roslyn · live analysis</span>
          </div>

          <div class="entry__proof-alert">
            <span class="entry__severity entry__severity--fault">
              <i aria-hidden="true">×</i> error
            </span>
            <span class="entry__severity entry__severity--fixed">
              <i aria-hidden="true">✓</i> fixed
            </span>
            <strong>{proof.diagnostic}</strong>
            <span class="entry__proof-message entry__proof-message--fault">
              {proof.problem}
            </span>
            <span class="entry__proof-message entry__proof-message--fixed">
              {proof.result}
            </span>
            <span class="entry__proof-available">1 quick fix available</span>
          </div>

          <div class="entry__proof-workspace">
            <section class="entry__editor" aria-label={`${proof.file} code preview`}>
              <header class="entry__editor-head">
                <span><i aria-hidden="true"></i>{proof.file}</span>
                <code>Ln {proof.line}</code>
              </header>

              <div class="entry__code-window">
                <div class="entry__code-state entry__code-state--fault">
                  {proof.before.map((codeLine, lineIndex) => (
                    <span class="entry__code-row">
                      <b aria-hidden="true">{proof.line + lineIndex}</b>
                      <code>{codeLine || " "}</code>
                    </span>
                  ))}
                  <span class="entry__squiggle" aria-hidden="true"></span>
                </div>

                <div class="entry__code-state entry__code-state--fixed">
                  {proof.after.map((codeLine, lineIndex) => (
                    <span class="entry__code-row">
                      <b aria-hidden="true">{proof.line + lineIndex}</b>
                      <code>{codeLine || " "}</code>
                    </span>
                  ))}
                  <span class="entry__clean-line" aria-hidden="true">
                    build clean
                  </span>
                </div>
              </div>
            </section>

            <aside class="entry__fix-panel">
              <p>Automatic code fix</p>
              <strong>{proof.fix}</strong>
              <span>
                Preview the compiler-safe rewrite, then keep it or switch back.
              </span>
              <button
                type="button"
                class="entry__fix-button"
                data-code-fix-toggle
                aria-pressed="false"
                aria-label={`Apply quick fix for ${proof.diagnostic}`}
              >
                <span class="entry__fix-button-label entry__fix-button-label--apply">
                  Apply quick fix
                </span>
                <span class="entry__fix-button-label entry__fix-button-label--revert">
                  Revert preview
                </span>
                <i aria-hidden="true">→</i>
              </button>

              <div class="entry__fix-route" aria-hidden="true">
                <span>fault</span>
                <i><b></b></i>
                <strong>protected</strong>
              </div>
            </aside>
          </div>

          <footer class="entry__proof-result">
            <p>
              <span aria-hidden="true">✓</span>
              <strong>Caught before the build.</strong>
              {proof.result}
            </p>
            <span class="entry__proof-state">
              <i aria-hidden="true"></i>
              <span class="entry__proof-state-fault">diagnostic active</span>
              <span class="entry__proof-state-fixed">0 errors</span>
            </span>
          </footer>
        </div>
      )
    }

    {
      (repo || nuget) && (
        <div class="entry__meta">
          {nuget && (
            <span class="entry__metaitem entry__downloads">
              <strong>{formatCount(nuget.totalDownloads)}</strong> NuGet
              downloads
            </span>
          )}
          {nuget && <span class="entry__metaitem">v{nuget.version}</span>}
          {repo?.language && (
            <span class="entry__metaitem">
              <span
                class="lang-dot"
                style={`--dot:${languageColor(repo.language)}`}
              />
              {repo.language}
            </span>
          )}
          {repo && repo.stars > 0 && (
            <span class="entry__metaitem">
              <span class="entry__star">★</span> {formatCount(repo.stars)}
            </span>
          )}
          {repo && (
            <span class="entry__metaitem entry__updated">
              Updated {relativeTime(repo.pushed_at, now)}
            </span>
          )}
        </div>
      )
    }

    {
      topics.length > 0 && (
        <ul class="entry__tags" aria-label="Topics">
          {topics.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }

    {
      uniqueLinks.length > 0 && (
        <div class="entry__links">
          {uniqueLinks.map((l) => (
            <a
              class="link entry__link"
              href={l.href}
              target="_blank"
              rel="noopener"
            >
              {l.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: clamp(7.6rem, 12vw, 10.5rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(2.2rem, 5vw, 3.6rem) 0;
    border-top: 1.5px solid var(--ink);
  }

  .entry__rail {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.2vw, 0.78rem);
    color: var(--fault);
    padding-top: 0.5rem;
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
  }

  .entry__rail-signal {
    width: 0.7rem;
    height: 0.7rem;
    margin-bottom: 0.35rem;
    border: 2px solid var(--fault);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--fault-wash);
  }

  .entry__rail small {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .entry__body {
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .entry__kicker {
    margin-bottom: 0.9rem;
  }

  .entry__title {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 144,
      "WONK" 1,
      "wght" 540;
    font-size: clamp(2.3rem, 6.5vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-bottom: 1.1rem;
    /* Long compound titles (e.g. "LinqContraband") must break rather than
       force horizontal scroll on narrow phones. overflow-wrap has to sit on
       the block to govern the line box; on the inline <a> alone it is ignored. */
    overflow-wrap: break-word;
  }
  .entry__title-link {
    color: var(--ink);
    overflow-wrap: anywhere;
    /* Override .link's white-space:nowrap so multi-word titles
       ("AutoMapper Analyser") wrap on narrow phones instead of overflowing. */
    white-space: normal;
  }

  .entry__blurb {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 32,
      "WONK" 0,
      "wght" 400;
    font-size: clamp(1.1rem, 1.7vw, 1.5rem);
    line-height: 1.42;
    color: var(--ink-soft);
    max-width: 46ch;
    margin-bottom: 1.6rem;
  }

  .entry__proof {
    --proof-bg: #080b10;
    --proof-panel: #101720;
    --proof-panel-raised: #151f2b;
    --proof-ink: #f3efe7;
    --proof-soft: #aeb8c6;
    --proof-faint: #68768a;
    --proof-rule: #29374a;
    --proof-fault: #ff6542;
    --proof-fix: #62c4ff;
    max-width: 61rem;
    margin: 0 0 1.8rem;
    overflow: hidden;
    border: 1px solid #36465c;
    border-radius: 13px;
    color: var(--proof-ink);
    background: var(--proof-bg);
    box-shadow:
      0 1.6rem 4rem rgb(0 0 0 / 0.24),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    isolation: isolate;
  }

  .entry__proof-chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 2.7rem;
    padding-inline: 0.9rem;
    border-bottom: 1px solid var(--proof-rule);
    color: var(--proof-faint);
    background: rgb(255 255 255 / 0.025);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .entry__proof-chrome > span:last-child {
    justify-self: end;
  }

  .entry__window-dots {
    display: flex;
    gap: 0.34rem;
  }

  .entry__window-dots i {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--proof-rule);
    border-radius: 50%;
  }

  .entry__window-dots i:first-child {
    border-color: var(--proof-fault);
    background: rgb(255 101 66 / 0.18);
  }

  .entry__proof-alert {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.3rem;
    padding: 0.68rem 0.9rem;
    border-bottom: 1px solid var(--proof-rule);
    background: linear-gradient(90deg, rgb(255 101 66 / 0.1), transparent 48%);
    transition: background 0.5s ease;
  }

  .entry__severity {
    grid-column: 1;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--proof-fault);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      opacity 0.35s ease,
      transform 0.35s var(--ease);
  }

  .entry__severity i {
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-style: normal;
  }

  .entry__severity--fixed {
    color: var(--proof-fix);
    opacity: 0;
    transform: translateY(0.4rem);
  }

  .entry__proof-alert > strong {
    grid-column: 2;
    flex: none;
    padding: 0.18rem 0.4rem;
    border: 1px solid currentColor;
    border-radius: 3px;
    color: var(--proof-fault);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 580;
    letter-spacing: 0.08em;
    transition: color 0.4s ease;
  }

  .entry__proof-message {
    grid-column: 3;
    grid-row: 1;
    min-width: 0;
    color: var(--proof-soft);
    font-size: clamp(0.66rem, 1.1vw, 0.78rem);
    line-height: 1.35;
    transition:
      opacity 0.35s ease,
      transform 0.35s var(--ease);
  }

  .entry__proof-message--fixed {
    opacity: 0;
    transform: translateY(0.4rem);
  }

  .entry__proof-available {
    grid-column: 4;
    color: var(--proof-fix);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  .entry__proof-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(13rem, 0.72fr);
    min-height: 14.5rem;
    background:
      linear-gradient(var(--proof-rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--proof-rule) 1px, transparent 1px),
      var(--proof-bg);
    background-size: 2.4rem 2.4rem;
  }

  .entry__editor {
    min-width: 0;
    border-right: 1px solid var(--proof-rule);
    background: rgb(8 11 16 / 0.86);
  }

  .entry__editor-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.55rem;
    padding-inline: 0.9rem;
    border-bottom: 1px solid var(--proof-rule);
    color: var(--proof-faint);
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  .entry__editor-head span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .entry__editor-head span i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--proof-fault);
    box-shadow: 0 0 0.65rem rgb(255 101 66 / 0.65);
    transition:
      background 0.4s ease,
      box-shadow 0.4s ease;
  }

  .entry__code-window {
    position: relative;
    min-height: 11.9rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 1.35rem;
  }

  .entry__code-state {
    position: relative;
    min-width: max-content;
    transition:
      opacity 0.45s ease,
      transform 0.45s var(--ease),
      filter 0.45s ease;
  }

  .entry__code-state--fixed {
    position: absolute;
    inset: 1.35rem 0 auto;
    opacity: 0;
    filter: blur(4px);
    transform: translateY(1rem);
  }

  .entry__code-row {
    display: grid;
    grid-template-columns: 3rem minmax(max-content, 1fr);
    min-height: 2.1rem;
    padding-right: 1.25rem;
    align-items: center;
    border-left: 2px solid transparent;
    font-family: var(--font-mono);
    font-size: clamp(0.69rem, 1.15vw, 0.82rem);
    transition:
      border-color 0.4s ease,
      background 0.4s ease;
  }

  .entry__code-state--fault .entry__code-row:nth-child(n + 2) {
    border-left-color: var(--proof-fault);
    background: linear-gradient(90deg, rgb(255 101 66 / 0.13), transparent 72%);
  }

  .entry__code-state--fixed .entry__code-row:nth-child(n + 2) {
    border-left-color: var(--proof-fix);
    background: linear-gradient(90deg, rgb(98 196 255 / 0.13), transparent 72%);
  }

  .entry__code-row b {
    padding-right: 0.8rem;
    color: var(--proof-faint);
    font-weight: 420;
    text-align: right;
    user-select: none;
  }

  .entry__code-row code {
    color: var(--proof-ink);
    white-space: pre;
  }

  .entry__squiggle {
    position: absolute;
    bottom: -0.08rem;
    left: 4rem;
    width: min(47%, 12rem);
    height: 0.35rem;
    background: var(--proof-fault);
    mask: var(--wave) 0 50% / 1rem 0.4rem repeat-x;
    opacity: 0.88;
  }

  .entry__clean-line {
    position: absolute;
    top: -0.75rem;
    right: 1rem;
    padding: 0.2rem 0.4rem;
    border: 1px solid rgb(98 196 255 / 0.48);
    border-radius: 3px;
    color: var(--proof-fix);
    background: rgb(98 196 255 / 0.08);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .entry__fix-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1rem, 2.2vw, 1.35rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 92% 10%, rgb(98 196 255 / 0.15), transparent 36%),
      linear-gradient(145deg, var(--proof-panel-raised), var(--proof-panel));
  }

  .entry__fix-panel::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    content: "";
    background: linear-gradient(var(--proof-fault), var(--proof-fix));
  }

  .entry__fix-panel > p {
    color: var(--proof-fix);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .entry__fix-panel > strong {
    max-width: 19ch;
    margin-top: 0.6rem;
    color: var(--proof-ink);
    font-family: var(--font-sans);
    font-size: clamp(0.92rem, 1.6vw, 1.12rem);
    font-variation-settings: "wght" 630;
    line-height: 1.2;
  }

  .entry__fix-panel > span {
    max-width: 29ch;
    margin-top: 0.6rem;
    color: var(--proof-soft);
    font-size: 0.67rem;
    line-height: 1.45;
  }

  .entry__fix-button {
    display: none;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    min-height: 2.75rem;
    margin-top: 1rem;
    padding: 0.65rem 0.78rem;
    overflow: hidden;
    border: 1px solid var(--proof-fix);
    border-radius: 5px;
    color: #061019;
    background: var(--proof-fix);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 620;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      color 0.3s ease,
      background 0.3s ease,
      transform 0.3s var(--ease);
  }

  :global(.js) .entry__fix-button {
    display: grid;
  }

  .entry__fix-button:hover {
    transform: translateY(-2px);
  }

  .entry__fix-button-label {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    transition:
      opacity 0.3s ease,
      transform 0.3s var(--ease);
  }

  .entry__fix-button-label--revert {
    opacity: 0;
    transform: translateY(0.6rem);
  }

  .entry__fix-button > i {
    grid-column: 2;
    grid-row: 1;
    font-style: normal;
    transition: transform 0.35s var(--ease);
  }

  .entry__fix-route {
    display: grid;
    grid-template-columns: auto minmax(1rem, 1fr) auto;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.05rem;
    color: var(--proof-faint);
    font-family: var(--font-mono);
    font-size: 0.46rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .entry__fix-route strong {
    color: var(--proof-fix);
    font-weight: 520;
  }

  .entry__fix-route i {
    position: relative;
    height: 1px;
    background: linear-gradient(90deg, var(--proof-fault), var(--proof-fix));
  }

  .entry__fix-route b {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--proof-fault);
    box-shadow: 0 0 0.55rem var(--proof-fault);
    transform: translateY(-50%);
    animation: proof-route 3s var(--ease) infinite;
  }

  .entry__proof-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.72rem 0.9rem;
    border-top: 1px solid var(--proof-rule);
    color: var(--proof-soft);
    background: var(--proof-panel);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.45;
  }

  .entry__proof-result p > span {
    margin-right: 0.3rem;
    color: var(--proof-fix);
  }

  .entry__proof-result p > strong {
    margin-right: 0.25rem;
    color: var(--proof-ink);
    font-weight: 580;
  }

  .entry__proof-state {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.42rem;
    min-width: 7.7rem;
    padding: 0.32rem 0.48rem;
    border: 1px solid rgb(255 101 66 / 0.42);
    border-radius: 999px;
    color: var(--proof-fault);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      color 0.4s ease,
      border-color 0.4s ease;
  }

  .entry__proof-state > i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0.5rem currentColor;
  }

  .entry__proof-state-fault,
  .entry__proof-state-fixed {
    grid-column: 2;
    grid-row: 1;
  }

  .entry__proof-state-fixed {
    display: none;
  }

  .entry__proof[data-fixed="true"] .entry__proof-alert {
    background: linear-gradient(90deg, rgb(98 196 255 / 0.1), transparent 48%);
  }

  .entry__proof[data-fixed="true"] .entry__severity--fault,
  .entry__proof[data-fixed="true"] .entry__proof-message--fault {
    opacity: 0;
    transform: translateY(-0.4rem);
  }

  .entry__proof[data-fixed="true"] .entry__severity--fixed,
  .entry__proof[data-fixed="true"] .entry__proof-message--fixed {
    opacity: 1;
    transform: none;
  }

  .entry__proof[data-fixed="true"] .entry__proof-alert > strong {
    color: var(--proof-fix);
  }

  .entry__proof[data-fixed="true"] .entry__proof-available {
    opacity: 0;
  }

  .entry__proof[data-fixed="true"] .entry__editor-head span i {
    background: var(--proof-fix);
    box-shadow: 0 0 0.65rem rgb(98 196 255 / 0.65);
