---
import type { Repo } from "../data/github";
import type { NuGetPackage } from "../data/nuget";
import type { ProjectProof } from "../data/featured";
import { languageColor, formatCount, relativeTime, pad2 } from "../lib/format";

interface Props {
  index: number;
  kicker: string;
  title: string;
  blurb: string;
  repo?: Repo;
  primary?: { label: string; href: string };
  package?: NuGetPackage;
  proof?: ProjectProof;
  anchor: string;
}
const {
  index,
  kicker,
  title,
  blurb,
  repo,
  primary,
  package: nuget,
  proof,
  anchor,
} = Astro.props;

// Destinations are editorially explicit. Deduping prevents a GitHub homepage
// from producing two differently-labelled links to the same place.
const links: { href: string; label: string }[] = [];
if (primary) links.push(primary);
if (repo) links.push({ href: repo.html_url, label: "GitHub" });
const uniqueLinks = [
  ...new Map(
    links.map((link) => [link.href.replace(/\/$/, ""), link]),
  ).values(),
];

const primaryHref = uniqueLinks[0]?.href ?? repo?.html_url ?? "#";
const topics = (repo?.topics ?? []).slice(0, 6);
const now = new Date();
---

<article class="entry reveal" id={anchor}>
  <div
    class="entry__rail"
    aria-label={proof ? `Diagnostic ${proof.diagnostic}` : `Project ${index}`}
  >
    <span class="entry__rail-signal" aria-hidden="true"></span>
    <span>{proof?.diagnostic ?? pad2(index)}</span>
    <small>{proof ? "diagnostic" : "selected work"}</small>
  </div>

  <div class="entry__body">
    <p class="kicker entry__kicker">{kicker}</p>

    <h3 class="entry__title">
      <a
        href={primaryHref}
        target="_blank"
        rel="noopener"
        class="link link--on entry__title-link"
      >
        {title}
      </a>
    </h3>

    <p class="entry__blurb">{blurb}</p>

    {
      proof && (
        <div class="entry__proof" aria-label={`${title} diagnostic example`}>
          <div class="entry__proof-head">
            <span class="entry__diagnostic">{proof.diagnostic}</span>
            <p>{proof.problem}</p>
          </div>
          <div class="entry__diff">
            <div>
              <span class="entry__diff-label">Before</span>
              <pre>
                <code>{proof.before.join("\n")}</code>
              </pre>
            </div>
            <div>
              <span class="entry__diff-label entry__diff-label--fixed">
                Quick fix
              </span>
              <pre>
                <code>{proof.after.join("\n")}</code>
              </pre>
            </div>
          </div>
          <p class="entry__result">
            <span aria-hidden="true">✓</span> {proof.result}
          </p>
        </div>
      )
    }

    {
      (repo || nuget) && (
        <div class="entry__meta">
          {nuget && (
            <span class="entry__metaitem entry__downloads">
              <strong>{formatCount(nuget.totalDownloads)}</strong> NuGet
              downloads
            </span>
          )}
          {nuget && <span class="entry__metaitem">v{nuget.version}</span>}
          {repo?.language && (
            <span class="entry__metaitem">
              <span
                class="lang-dot"
                style={`--dot:${languageColor(repo.language)}`}
              />
              {repo.language}
            </span>
          )}
          {repo && repo.stars > 0 && (
            <span class="entry__metaitem">
              <span class="entry__star">★</span> {formatCount(repo.stars)}
            </span>
          )}
          {repo && (
            <span class="entry__metaitem entry__updated">
              Updated {relativeTime(repo.pushed_at, now)}
            </span>
          )}
        </div>
      )
    }

    {
      topics.length > 0 && (
        <ul class="entry__tags" aria-label="Topics">
          {topics.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }

    {
      uniqueLinks.length > 0 && (
        <div class="entry__links">
          {uniqueLinks.map((l) => (
            <a
              class="link entry__link"
              href={l.href}
              target="_blank"
              rel="noopener"
            >
              {l.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: clamp(7.6rem, 12vw, 10.5rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(2.2rem, 5vw, 3.6rem) 0;
    border-top: 1.5px solid var(--ink);
  }

  .entry__rail {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.2vw, 0.78rem);
    color: var(--fault);
    padding-top: 0.5rem;
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
  }

  .entry__rail-signal {
    width: 0.7rem;
    height: 0.7rem;
    margin-bottom: 0.35rem;
    border: 2px solid var(--fault);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--fault-wash);
  }

  .entry__rail small {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .entry__body {
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .entry__kicker {
    margin-bottom: 0.9rem;
  }

  .entry__title {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 144,
      "WONK" 1,
      "wght" 540;
    font-size: clamp(2.3rem, 6.5vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-bottom: 1.1rem;
    /* Long compound titles (e.g. "LinqContraband") must break rather than
       force horizontal scroll on narrow phones. overflow-wrap has to sit on
       the block to govern the line box; on the inline <a> alone it is ignored. */
    overflow-wrap: break-word;
  }
  .entry__title-link {
    color: var(--ink);
    overflow-wrap: anywhere;
    /* Override .link's white-space:nowrap so multi-word titles
       ("AutoMapper Analyser") wrap on narrow phones instead of overflowing. */
    white-space: normal;
  }

  .entry__blurb {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 32,
      "WONK" 0,
      "wght" 400;
    font-size: clamp(1.1rem, 1.7vw, 1.5rem);
    line-height: 1.42;
    color: var(--ink-soft);
    max-width: 46ch;
    margin-bottom: 1.6rem;
  }

  .entry__proof {
    max-width: 52rem;
    margin: 0 0 1.7rem;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--paper-raised);
  }
  .entry__proof-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--rule);
    border-left: 3px solid var(--fault);
    font-size: 0.86rem;
    color: var(--ink-soft);
  }
  .entry__diagnostic,
  .entry__diff-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .entry__diagnostic {
    padding: 0.12em 0.45em;
    border: 1px solid currentColor;
    border-radius: 4px;
    color: var(--fault);
  }
  .entry__diff {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .entry__diff > div {
    min-width: 0;
    padding: 1rem;
  }
  .entry__diff > div + div {
    border-left: 1px solid var(--rule);
    background: var(--fix-wash);
  }
  .entry__diff-label {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--ink-faint);
  }
  .entry__diff-label--fixed {
    color: var(--fix);
  }
  .entry__diff pre {
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.4vw, 0.8rem);
    line-height: 1.7;
    color: var(--ink);
  }
  .entry__result {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .entry__result span {
    color: var(--fix);
  }

  .entry__meta {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin-bottom: 1.2rem;
  }
  .entry__metaitem {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .entry__star {
    color: var(--accent-text);
  }
  .entry__downloads strong {
    color: var(--ink);
    font-weight: 650;
  }
  .entry__updated {
    color: var(--ink-faint);
  }

  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-bottom: 1.6rem;
  }

  .entry__links {
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.03em;
  }
  .entry__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 620px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .entry__rail {
      padding-top: 0;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }

    .entry__rail-signal {
      margin: 0 0.2rem 0 0;
    }
    .entry__diff {
      grid-template-columns: 1fr;
    }
    .entry__diff > div + div {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
