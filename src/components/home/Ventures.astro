---
import { COLLABS, collabLinkRel } from "../../data/collabs";

const bySlug = (slug: string) => COLLABS.find((c) => c.slug === slug)!;
const dansu = bySlug("dansu");
const influ = bySlug("influ");
const rel = collabLinkRel();
---

<section class="ventures" id="ventures" aria-labelledby="ventures-title">
  <div class="wrap">
    <header class="section-head reveal">
      <div>
        <p class="kicker">Ventures</p>
        <h2 class="display section-head__title" id="ventures-title">
          Companies I'm <em>building</em>.
        </h2>
      </div>
      <p class="section-head__lede">
        I co-founded <a class="link link--on" href={dansu.href} target="_blank" rel={rel}
          >{dansu.anchor}</a
        >, and I build the product at <a
          class="link link--on"
          href={influ.href}
          target="_blank"
          rel={rel}>{influ.anchor}</a
        >. Both are live, and I work on them end to end.
      </p>
    </header>

    <!-- Dansu: the co-founder story leads, with real product photography. -->
    <article class="venture venture--dansu reveal" aria-labelledby="venture-dansu">
      <div class="venture__media">
        <img
          src={dansu.gallery[0].src}
          alt={dansu.gallery[0].alt}
          width="1800"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figure class="venture__inset">
          <img
            src={dansu.gallery[1].src}
            alt={dansu.gallery[1].alt}
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <figcaption>World Cup 26 campaign</figcaption>
        </figure>
      </div>

      <div class="venture__body">
        <div class="venture__meta">
          <span class="venture__role">{dansu.role}</span>
          <span class="venture__kicker">{dansu.kicker}</span>
        </div>
        <h3 class="display venture__title" id="venture-dansu">{dansu.title}</h3>
        <p class="venture__blurb">{dansu.blurb}</p>
        <dl class="venture__facts">
          {
            dansu.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <a class="btn venture__cta" href={dansu.href} target="_blank" rel={rel}>
          {dansu.cta}<span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </article>

    <!-- INFLU: an editorial look grid with the live Style Index read-out. -->
    <article class="venture venture--influ reveal" aria-labelledby="venture-influ">
      <div class="venture__body">
        <div class="venture__meta">
          <span class="venture__role">{influ.role}</span>
          <span class="venture__kicker">{influ.kicker}</span>
        </div>
        <h3 class="venture__title venture__title--influ" id="venture-influ">
          <img src="/ventures/influ/wordmark.svg" alt={influ.title} width="280" height="50" />
        </h3>
        <p class="venture__blurb">{influ.blurb}</p>
        <dl class="venture__facts">
          {
            influ.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <a class="btn venture__cta" href={influ.href} target="_blank" rel={rel}>
          {influ.cta}<span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="venture__looks">
        {
          influ.gallery.map((look, i) => (
            <figure class={`look look--${i + 1}`}>
              <img
                src={look.src}
                alt={look.alt}
                width="560"
                height="746"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="look__score" aria-hidden="true">
                {[87, 72, 91, 64, 88, 79][i]}
              </figcaption>
            </figure>
          ))
        }
        <div class="venture__index" aria-hidden="true">
          <span class="venture__index-k">{influ.scene.metricLabel}</span>
          <span class="venture__index-v">{influ.scene.metricValue}</span>
          <span class="venture__index-s">{influ.scene.status}</span>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .ventures {
    padding-top: var(--section-gap);
  }

  .venture {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    border-radius: calc(var(--radius) + 6px);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .venture + .venture {
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .venture--influ {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
  }

  .venture__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4.5vw, 4rem);
  }

  .venture__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .venture__role {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 0.85em;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .venture__kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .venture__title {
    font-size: clamp(3.4rem, 8vw, 7rem);
    line-height: 0.88;
  }

  .venture__title--influ img {
    width: clamp(200px, 26vw, 340px);
    height: auto;
  }

  :global(:root[data-theme="light"]) .venture__title--influ img {
    filter: invert(1);
  }

  .venture__blurb {
    color: var(--ink-soft);
    font-size: clamp(1rem, 0.96rem + 0.3vw, 1.15rem);
    line-height: 1.6;
    max-width: 44ch;
  }

  .venture__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    margin-top: 0.4rem;
  }

  .venture__facts div {
    padding: 1rem 0.75rem 0 0;
  }

  .venture__facts dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .venture__facts dd {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }

  .venture__cta {
    align-self: flex-start;
    margin-top: 0.6rem;
  }

  /* ----- Dansu media ----- */
  .venture__media {
    position: relative;
    min-height: clamp(360px, 46vw, 640px);
    background: #e9eef2;
  }

  .venture__media > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease);
  }

  .venture:hover .venture__media > img {
    transform: scale(1.03);
  }

  .venture__inset {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    width: clamp(140px, 30%, 250px);
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.6);
    background: #000;
  }

  .venture__inset img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .venture__inset figcaption {
    padding: 0.55rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f3efe6;
    background: #0b0b0c;
  }

  /* ----- INFLU look grid ----- */
  .venture__looks {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    padding: 0.6rem;
    background: #0d0d0e;
  }

  .look {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 3 / 4;
  }

  .look img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition:
      transform 1s var(--ease),
      filter 0.6s ease;
  }

  .look:hover img {
    transform: scale(1.05);
    filter: saturate(1.1);
  }

  .look__score {
    position: absolute;
    left: 0.6rem;
    bottom: 0.5rem;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-variation-settings:
      "wght" 650,
      "wdth" 100;
    letter-spacing: -0.04em;
    color: #fff;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.6);
  }

  .venture__index {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1.1rem;
    border-radius: 14px;
    background: rgba(10, 10, 11, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(57, 255, 136, 0.35);
    color: #f3efe6;
  }

  .venture__index-k,
  .venture__index-s {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .venture__index-s {
    color: #39ff88;
  }

  .venture__index-v {
    font-size: 2.6rem;
    line-height: 1;
    font-variation-settings:
      "wght" 700,
      "wdth" 110;
    letter-spacing: -0.05em;
    color: #39ff88;
  }

  @media (max-width: 900px) {
    .venture,
    .venture--influ {
      grid-template-columns: minmax(0, 1fr);
    }

    .venture--influ .venture__looks {
      order: -1;
    }

    .venture__media {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 520px) {
    .venture__facts {
      grid-template-columns: 1fr 1fr;
    }

    .venture__looks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .look--5,
    .look--6 {
      display: none;
    }
  }
</style>
