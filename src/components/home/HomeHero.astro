---
import { formatCount } from "../../lib/format";

interface Props {
  totalDownloads: number;
  shippedApps: number;
}

const { totalDownloads, shippedApps } = Astro.props;

const downloadsLabel = `${Math.floor(totalDownloads / 1000)}K+`;

const STATS = [
  { value: downloadsLabel, label: "NuGet downloads across my .NET tools" },
  { value: String(shippedApps), label: "iOS apps live on the App Store" },
  { value: "2", label: "Ventures: co-founder of Dansu, building INFLU" },
  { value: "10+", label: "Years engineering fintech systems" },
];

const MARQUEE = [
  "Dansu",
  "INFLU",
  "GemGame",
  "Fleet Commander",
  "NoBooze",
  "LinqContraband",
  "CancelCop",
  "DI Lifetime Analysers",
  "CPMigrate",
  "ConfigContraband",
  "NotifyGen",
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="kicker intro" style="--intro-delay: 80ms">
        Engineer · Founder · London
      </p>

      <h1 class="display hero__title" id="hero-title">
        <span class="intro-mask"
          ><span class="intro-line" style="--intro-delay: 140ms">I build</span></span
        >
        <span class="intro-mask"
          ><span class="intro-line" style="--intro-delay: 220ms"
            >products people</span
          ></span
        >
        <span class="intro-mask"
          ><span class="intro-line" style="--intro-delay: 300ms"
            ><em>actually</em> use.</span
          ></span
        >
      </h1>

      <p class="hero__lede intro" style="--intro-delay: 420ms">
        I'm George Wall. I co-founded <a class="hero__inline" href="#ventures"
          >Dansu</a
        >, build the fashion intelligence platform behind <a
          class="hero__inline"
          href="#ventures">INFLU</a
        >, ship my own <a class="hero__inline" href="#apps">iOS apps</a>, and write
        <a class="hero__inline" href="#tools">.NET analysers</a> with {
          formatCount(totalDownloads)
        } downloads on NuGet.
      </p>

      <div class="hero__actions intro" style="--intro-delay: 520ms">
        <a class="btn" href="#ventures"
          >See the work <span class="arrow" aria-hidden="true">↓</span></a
        >
        <a class="btn btn--ghost" href="#contact">Get in touch</a>
      </div>
    </div>

    <div class="hero__stage intro" style="--intro-delay: 300ms" aria-hidden="true">
      <div class="hero__fan">
        <div class="phone hero__phone hero__phone--l">
          <img
            src="/apps/fleet/route.webp"
            alt=""
            width="600"
            height="1305"
            fetchpriority="high"
          />
        </div>
        <div class="phone hero__phone hero__phone--r">
          <img
            src="/apps/nobooze-today.webp"
            alt=""
            width="600"
            height="1300"
            fetchpriority="high"
          />
        </div>
        <div class="phone hero__phone hero__phone--c">
          <img
            src="/apps/gemgame/gameplay.webp"
            alt=""
            width="600"
            height="1300"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="hero__chip hero__chip--a">
        <span class="hero__chip-dot"></span>
        <span><strong>Co-founder</strong> · Dansu</span>
      </div>
      <div class="hero__chip hero__chip--b">
        <span class="hero__chip-k">{downloadsLabel}</span>
        <span>NuGet downloads</span>
      </div>
      <div class="hero__chip hero__chip--c">
        <span class="hero__chip-k">{shippedApps}</span>
        <span>apps on the App Store</span>
      </div>
    </div>
  </div>

  <div class="wrap">
    <dl class="hero__stats">
      {
        STATS.map((stat, i) => (
          <div class="hero__stat intro" style={`--intro-delay: ${620 + i * 70}ms`}>
            <dt class="sr-only">{stat.label}</dt>
            <dd class="hero__stat-value">{stat.value}</dd>
            <dd class="hero__stat-label" aria-hidden="true">
              {stat.label}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [...MARQUEE, ...MARQUEE].map((name) => (
          <span class="marquee__item">{name}</span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 7vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: min(70vw, 1000px);
    aspect-ratio: 1;
    z-index: -1;
    background:
      radial-gradient(closest-side, rgba(255, 91, 55, 0.22), transparent 70%),
      radial-gradient(closest-side at 70% 60%, rgba(124, 200, 255, 0.1), transparent 70%);
    filter: blur(20px);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 65% 30%, #000 10%, transparent 75%);
    opacity: 0.55;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    min-height: min(78vh, 760px);
  }

  .hero__title {
    margin-top: 1.6rem;
    font-size: min(clamp(2.9rem, 6.2vw, 6.1rem), 11.2vw);
    white-space: nowrap;
  }

  .hero__title em {
    color: var(--accent);
    padding-right: 0.06em;
  }

  .hero__lede {
    margin-top: clamp(1.5rem, 3vw, 2.2rem);
    max-width: 36rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.6;
  }

  .hero__inline {
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s var(--ease);
  }

  .hero__inline:hover {
    background-size: 100% 2px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: clamp(2rem, 4vw, 2.8rem);
  }

  /* ----- Device fan ----- */
  .hero__stage {
    position: relative;
    height: clamp(460px, 52vw, 680px);
  }

  .hero__fan {
    position: absolute;
    inset: 0;
  }

  .hero__phone {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(170px, 17vw, 250px);
    transition: transform 0.9s var(--ease);
  }

  .hero__phone--c {
    z-index: 3;
    transform: translate(-50%, -50%);
  }

  .hero__phone--l {
    z-index: 1;
    transform: translate(-112%, -46%) rotate(-9deg) scale(0.88);
  }

  .hero__phone--r {
    z-index: 2;
    transform: translate(12%, -44%) rotate(8deg) scale(0.88);
  }

  .hero__stage:hover .hero__phone--l {
    transform: translate(-122%, -47%) rotate(-12deg) scale(0.9);
  }

  .hero__stage:hover .hero__phone--r {
    transform: translate(22%, -45%) rotate(11deg) scale(0.9);
  }

  .hero__stage:hover .hero__phone--c {
    transform: translate(-50%, -52%);
  }

  .hero__chip {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--rule-strong);
    background: color-mix(in srgb, var(--paper-raised) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: var(--shadow-lg);
    font-size: 0.86rem;
    color: var(--ink-soft);
    white-space: nowrap;
    animation: float 7s ease-in-out infinite;
  }

  .hero__chip strong {
    color: var(--ink);
    font-weight: 650;
  }

  .hero__chip-k {
    font-weight: 700;
    font-variation-settings:
      "wght" 720,
      "wdth" 110;
    color: var(--ink);
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .hero__chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.18);
  }

  .hero__chip--a {
    top: 9%;
    right: 2%;
  }

  .hero__chip--b {
    bottom: 13%;
    left: -2%;
    animation-delay: -2.5s;
  }

  .hero__chip--c {
    bottom: 4%;
    right: 6%;
    animation-delay: -4.5s;
  }

  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  /* ----- Stats ----- */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--rule);
  }

  .hero__stat {
    padding: 1.6rem 1.4rem 1.6rem 0;
  }

  .hero__stat + .hero__stat {
    padding-left: 1.4rem;
    border-left: 1px solid var(--rule);
  }

  .hero__stat-value {
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    font-variation-settings:
      "wght" 700,
      "wdth" 110;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .hero__stat-label {
    margin-top: 0.6rem;
    color: var(--ink-faint);
    font-size: 0.9rem;
    line-height: 1.4;
    max-width: 22ch;
  }

  /* ----- Marquee ----- */
  .marquee {
    margin-top: clamp(1rem, 3vw, 2rem);
    border-block: 1px solid var(--rule);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 2.4rem;
    padding: 1.3rem 1.2rem;
    padding-right: 1.2rem;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-variation-settings:
      "wght" 600,
      "wdth" 106;
    letter-spacing: -0.03em;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .marquee__item::after {
    content: "✦";
    font-size: 0.6em;
    color: var(--accent);
    margin-left: 1.2rem;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track,
    .hero__chip {
      animation: none;
    }
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .hero__stage {
      height: clamp(420px, 105vw, 560px);
    }

    .hero__phone {
      width: clamp(150px, 36vw, 220px);
    }

    .hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero__stat.hero__stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .hero__stat:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 520px) {
    .hero__chip--a {
      right: 0;
      top: 2%;
    }

    .hero__chip--b {
      left: 0;
    }

    .hero__chip--c {
      display: none;
    }
  }
</style>
