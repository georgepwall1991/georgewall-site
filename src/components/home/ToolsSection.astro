---
import type { Featured } from "../../data/featured";
import type { NuGetPackage } from "../../data/nuget";
import { formatCount } from "../../lib/format";

interface Entry extends Featured {
  package?: NuGetPackage;
  repoUrl?: string;
}

interface Props {
  entries: Entry[];
  totalDownloads: number;
}

const { entries, totalDownloads } = Astro.props;

const lead = entries.find((e) => e.proof)!;
const proof = lead.proof!;
const ranked = entries
  .filter((e) => e.package)
  .sort((a, b) => b.package!.totalDownloads - a.package!.totalDownloads);
const max = ranked[0]?.package?.totalDownloads ?? 1;
---

<section class="tools" id="tools" aria-labelledby="tools-title">
  <div class="wrap">
    <header class="section-head reveal">
      <div>
        <p class="kicker">Developer tools</p>
        <h2 class="display section-head__title" id="tools-title">
          Guardrails for <em>.NET</em> teams.
        </h2>
      </div>
      <p class="section-head__lede">
        Roslyn analysers, source generators and CLIs that catch production bugs while the
        code is still in the editor. {formatCount(totalDownloads)} downloads on NuGet so far.
      </p>
    </header>

    <div class="tools__grid">
      <article class="tool-lead reveal" aria-labelledby="tool-lead-title">
        <div class="tool-lead__top">
          <p class="tool-lead__kicker">{lead.kicker}</p>
          <h3 class="tool-lead__title" id="tool-lead-title">{lead.title}</h3>
          <p class="tool-lead__blurb">{lead.blurb}</p>
        </div>

        <div class="editor" role="img" aria-label={`${proof.diagnostic}: ${proof.problem}`}>
          <div class="editor__bar" aria-hidden="true">
            <span class="editor__dots"><i></i><i></i><i></i></span>
            <span class="editor__file">{proof.file}</span>
            <span class="editor__badge">{proof.diagnostic}</span>
          </div>
          <div class="editor__body" aria-hidden="true">
            <div class="editor__pane editor__pane--before">
              <p class="editor__label">Before</p>
              {
                proof.before.map((line, i) => (
                  <code class={`editor__line ${i === 1 ? "is-flagged" : ""}`}>
                    <span class="editor__ln">{proof.line + i}</span>
                    {line}
                  </code>
                ))
              }
              <p class="editor__diag">
                <span class="editor__sev">warning</span>
                {proof.problem}
              </p>
            </div>
            <div class="editor__pane editor__pane--after">
              <p class="editor__label">Quick fix · {proof.fix}</p>
              {
                proof.after.map((line, i) => (
                  <code class={`editor__line ${i === 1 ? "is-fixed" : ""}`}>
                    <span class="editor__ln">{proof.line + i}</span>
                    {line}
                  </code>
                ))
              }
            </div>
          </div>
        </div>

        <div class="tool-lead__foot">
          {
            lead.package && (
              <span class="tool-lead__stat">
                <strong>{formatCount(lead.package.totalDownloads)}</strong> downloads ·
                v{lead.package.version}
              </span>
            )
          }
          {
            lead.primary && (
              <a class="btn btn--ghost" href={lead.primary.href} target="_blank" rel="noopener">
                {lead.primary.label}
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
      </article>

      <div class="tool-board reveal" style="--reveal-delay: 120ms">
        <p class="tool-board__head">
          <span>Package</span><span>Downloads</span>
        </p>
        <ol class="tool-board__list">
          {
            ranked.map((e) => (
              <li class="tool-row">
                <a
                  class="tool-row__link"
                  href={e.primary?.href ?? e.package!.url}
                  target="_blank"
                  rel="noopener"
                >
                  <span class="tool-row__name">
                    {e.title}
                    <span class="tool-row__kind">{e.kicker.split("·").pop()?.trim()}</span>
                  </span>
                  <span class="tool-row__count">
                    {formatCount(e.package!.totalDownloads)}
                  </span>
                  <span
                    class="tool-row__bar"
                    style={`--w: ${((e.package!.totalDownloads / max) * 100).toFixed(1)}%`}
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ol>
        <a class="tool-board__more" href="/work">
          Every project, with live GitHub data <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .tools {
    padding-top: var(--section-gap);
  }

  .tools__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  .tool-lead,
  .tool-board {
    border-radius: calc(var(--radius) + 6px);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .tool-lead {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .tool-lead__kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fix);
  }

  .tool-lead__title {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-variation-settings:
      "wght" 700,
      "wdth" 108;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .tool-lead__blurb {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 52ch;
  }

  /* ----- Editor mock ----- */
  .editor {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0b0d12;
    color: #e6e3db;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.68rem + 0.2vw, 0.84rem);
  }

  .editor__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: #10131a;
    color: #8a8f99;
  }

  .editor__dots {
    display: flex;
    gap: 6px;
  }

  .editor__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2a2e37;
  }

  .editor__file {
    flex: 1;
  }

  .editor__badge {
    padding: 0.15em 0.6em;
    border-radius: 6px;
    border: 1px solid rgba(255, 91, 55, 0.5);
    color: #ff7a5c;
    font-size: 0.85em;
  }

  .editor__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .editor__pane {
    padding: 1rem 0 1.1rem;
  }

  .editor__pane--after {
    border-left: 1px solid rgba(255, 255, 255, 0.07);
    background: linear-gradient(180deg, rgba(124, 200, 255, 0.05), transparent);
  }

  .editor__label {
    padding: 0 1rem 0.7rem;
    font-size: 0.82em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6f7581;
  }

  .editor__pane--after .editor__label {
    color: #7cc8ff;
  }

  .editor__line {
    display: block;
    padding: 0.2rem 1rem;
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .editor__ln {
    display: inline-block;
    width: 2.2em;
    color: #4d525c;
  }

  .editor__line.is-flagged {
    background: rgba(255, 91, 55, 0.1);
    box-shadow: inset 2px 0 0 #ff5b37;
    text-decoration: underline wavy #ff5b37;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .editor__line.is-fixed {
    background: rgba(124, 200, 255, 0.1);
    box-shadow: inset 2px 0 0 #7cc8ff;
  }

  .editor__diag {
    margin: 0.9rem 1rem 0;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    background: rgba(255, 91, 55, 0.08);
    color: #d9d4c9;
    line-height: 1.45;
    font-size: 0.92em;
  }

  .editor__sev {
    color: #ff7a5c;
    margin-right: 0.4em;
  }

  .tool-lead__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .tool-lead__stat {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .tool-lead__stat strong {
    color: var(--ink);
    font-weight: 700;
  }

  /* ----- Download board ----- */
  .tool-board {
    display: flex;
    flex-direction: column;
  }

  .tool-board__head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .tool-board__list {
    list-style: none;
    flex: 1;
  }

  .tool-row__link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding: 1rem 0 1.05rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .tool-row__name {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .tool-row__kind {
    font-weight: 400;
    font-size: 0.82rem;
    color: var(--ink-faint);
    text-transform: capitalize;
  }

  .tool-row__count {
    font-variant-numeric: tabular-nums;
    font-variation-settings:
      "wght" 650,
      "wdth" 104;
    align-self: center;
  }

  .tool-row__bar {
    grid-column: 1 / -1;
    height: 3px;
    border-radius: 3px;
    background: var(--rule);
    position: relative;
    overflow: hidden;
  }

  .tool-row__bar::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), #ffb36b);
    transform-origin: 0 50%;
    transition: transform 1.2s var(--ease) 0.2s;
  }

  :global(html.js) .tool-board:not(.is-in) .tool-row__bar::after {
    transform: scaleX(0);
  }

  .tool-row__link:hover .tool-row__name {
    color: var(--accent-text);
  }

  .tool-board__more {
    margin-top: 1.4rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .tool-board__more:hover {
    color: var(--accent-text);
  }

  @media (max-width: 980px) {
    .tools__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .editor__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .editor__pane--after {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
  }
</style>
