---
interface Props {
  kicker: string;
  title: string;
  standfirst: string;
  detail?: string;
}

const { kicker, title, standfirst, detail } = Astro.props;
---

<header class="page-intro wrap">
  <p class="kicker intro" style="--intro-delay: 100ms">{kicker}</p>
  <h1 class="display page-intro__title">
    <span class="intro-mask"><span class="intro-line" style="--intro-delay: 200ms">{title}</span></span>
  </h1>
  <div class="page-intro__foot intro" style="--intro-delay: 360ms">
    <p class="page-intro__standfirst">{standfirst}</p>
    {detail && <p class="label page-intro__detail">{detail}</p>}
  </div>
</header>

<style>
  .page-intro {
    padding-top: clamp(4rem, 10vw, 8rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
    border-bottom: 1.5px solid var(--ink);
  }
  .page-intro__title {
    max-width: 15ch;
    margin: 1.1rem 0 2rem;
    font-size: clamp(3rem, 9vw, 8rem);
  }
  .page-intro__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .page-intro__standfirst {
    max-width: 54ch;
    font-size: clamp(1.08rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .page-intro__detail {
    flex: none;
  }
  @media (max-width: 680px) {
    .page-intro__foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
