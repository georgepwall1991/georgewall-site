---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../data/site";

// Root-relative anchors so the nav also works from /writing/* pages.
const NAV = [
  { href: "/#now", label: "Now", spy: "now" },
  { href: "/work", label: "Work", spy: "work" },
  { href: "/#apps", label: "Products", spy: "apps" },
  { href: "/writing", label: "Writing", spy: "writing" },
  { href: "/#about", label: "About", spy: "about" },
];
---

<header class="masthead" id="top">
  <div class="wrap masthead__inner">
    <a href="/" class="masthead__name intro" aria-label="George Wall, home">
      <span>George Wall</span>
    </a>

    <nav
      class="masthead__nav intro"
      style="--intro-delay: 120ms"
      aria-label="Primary"
    >
      {
        NAV.map((item) => (
          <a class="link" href={item.href} data-spy={item.spy}>
            {item.label}
          </a>
        ))
      }
      <a
        class="link"
        href="https://github.com/georgepwall1991"
        target="_blank"
        rel="noopener"
      >
        GitHub<span class="masthead__ext" aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="masthead__tools intro" style="--intro-delay: 200ms">
      <ThemeToggle />
      <button
        class="masthead__burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Open menu"
      >
        <span class="masthead__burger-line" aria-hidden="true"></span>
        <span class="masthead__burger-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Reading progress: a vermilion hairline that fills as you scroll. -->
  <div class="masthead__progress" aria-hidden="true"></div>
</header>

<!-- Mobile menu: full-screen editorial index. -->
<div class="menu" id="site-menu" hidden>
  <nav class="menu__nav" aria-label="Mobile">
    <ol class="menu__list">
      {
        NAV.map((item, i) => (
          <li class="menu__item">
            <a class="menu__link" href={item.href}>
              <span class="menu__no">{String(i + 1).padStart(2, "0")}</span>
              <span class="menu__label">{item.label}</span>
            </a>
          </li>
        ))
      }
      <li class="menu__item">
        <a
          class="menu__link"
          href="https://github.com/georgepwall1991"
          target="_blank"
          rel="noopener"
        >
          <span class="menu__no">↗</span>
          <span class="menu__label">GitHub</span>
        </a>
      </li>
      <li class="menu__item">
        <a class="menu__link" href="/#contact">
          <span class="menu__no">@</span>
          <span class="menu__label">Contact</span>
        </a>
      </li>
    </ol>
  </nav>
  <p class="menu__foot label">
    №&nbsp;{SITE.issueNo} · {SITE.location} · georgewall.uk
  </p>
</div>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.4s ease,
      background 0.4s ease;
  }

  .masthead[data-scrolled] {
    border-bottom-color: var(--rule);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: clamp(3.4rem, 7vw, 4.4rem);
  }

  .masthead__name {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 40,
      "WONK" 1,
      "wght" 560;
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
    min-height: 44px;
    justify-content: center;
    gap: 0.15em;
    white-space: nowrap;
  }

  .masthead__reg {
    font-family: var(--font-mono);
    font-size: 0.5em;
    color: var(--accent-text);
    transform: translateY(-0.6em);
  }

  .masthead__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .masthead__nav a {
    display: inline-block;
  }

  /* Scrollspy: the section in view wears a resting squiggle. */
  .masthead__nav a[data-active]::after {
    transform: scaleX(1);
    opacity: 0.55;
  }
  .masthead__nav a[data-active]:hover::after {
    opacity: 1;
  }

  .masthead__ext {
    font-size: 0.8em;
    margin-left: 0.1em;
  }

  .masthead__tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Reading progress hairline. Width driven by --progress (0–1) from JS. */
  .masthead__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: 0 50%;
  }

  /* ----- Burger ----- */
  .masthead__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 0.42rem;
    width: 44px;
    height: 44px;
    padding: 0.6rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .masthead__burger-line {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--ink);
    border-radius: 2px;
    transition:
      transform 0.35s var(--ease),
      background 0.3s ease;
  }
  .masthead__burger[aria-expanded="true"] .masthead__burger-line:first-child {
    transform: translateY(0.22rem) rotate(45deg);
    background: var(--accent);
  }
  .masthead__burger[aria-expanded="true"] .masthead__burger-line:last-child {
    transform: translateY(-0.22rem) rotate(-45deg);
    background: var(--accent);
  }

  /* ----- Mobile menu panel ----- */
  /* display:flex below would defeat the hidden attribute's UA display:none.
     restate it explicitly so the closed menu is actually gone. */
  .menu[hidden] {
    display: none !important;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
    background: var(--paper);
    padding: clamp(5rem, 16vw, 7rem) var(--gutter) 2rem;
  }

  .menu__list {
    list-style: none;
  }

  .menu__item {
    border-top: 1px solid var(--rule);
    overflow: hidden;
  }
  .menu__item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    padding: 1.05rem 0.2rem;
    text-decoration: none;
    color: var(--ink);
    transform: translateY(110%);
    transition: padding-left 0.3s var(--ease);
  }
  .menu__link:active {
    padding-left: 0.5rem;
  }

  .menu[data-open] .menu__link {
    animation: menu-in 0.6s var(--ease) forwards;
    animation-delay: calc(var(--i, 0) * 55ms);
  }

  .menu__no {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-text);
    min-width: 1.6rem;
  }

  .menu__label {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 110,
      "WONK" 1,
      "wght" 540;
    font-size: clamp(2.4rem, 10vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .menu__foot {
    margin-top: 2.2rem;
  }

  @keyframes menu-in {
    to {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__link,
    .menu[data-open] .menu__link {
      animation: none;
      transform: none;
    }

    .masthead__burger-line {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .masthead__nav {
      display: none;
    }
    .masthead__burger {
      display: flex;
    }
  }

  @media (max-height: 680px) and (max-width: 760px) {
    .menu {
      justify-content: flex-start;
      padding-top: 4.75rem;
    }

    .menu__link {
      padding-block: 0.68rem;
    }

    .menu__label {
      font-size: clamp(2rem, 8vh, 2.8rem);
    }

    .menu__foot {
      margin-block: 1.2rem;
    }
  }

  @media (min-width: 761px) {
    .menu {
      display: none !important;
    }
  }
</style>

<script>
  const masthead = document.querySelector<HTMLElement>(".masthead");
  const progress = document.querySelector<HTMLElement>(".masthead__progress");

  // Scroll state + reading progress, throttled to one write per frame.
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      if (!masthead) return;
      if (window.scrollY > 24) masthead.setAttribute("data-scrolled", "");
      else masthead.removeAttribute("data-scrolled");
      if (progress) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.setProperty(
          "--progress",
          String(max > 0 ? Math.min(window.scrollY / max, 1) : 0),
        );
      }
    });
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  onScroll();

  // Scrollspy: highlight the nav link of the section in view (index page only).
  const spyLinks = document.querySelectorAll<HTMLAnchorElement>(
    ".masthead__nav a[data-spy]",
  );
  const sections = [...spyLinks]
    .map((a) => document.getElementById(a.dataset.spy!))
    .filter((s): s is HTMLElement => Boolean(s));

  if (sections.length > 0) {
    const setActive = (id: string | null) => {
      spyLinks.forEach((a) => {
        if (a.dataset.spy === id) a.setAttribute("data-active", "");
        else a.removeAttribute("data-active");
      });
    };
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-25% 0px -65% 0px" },
    );
    sections.forEach((s) => spy.observe(s));
  }

  // Mobile menu.
  const burger = document.querySelector<HTMLButtonElement>(".masthead__burger");
  const menu = document.getElementById("site-menu");
  menu
    ?.querySelectorAll<HTMLElement>(".menu__link")
    .forEach((l, i) => l.style.setProperty("--i", String(i)));

  const setMenu = (open: boolean) => {
    if (!burger || !menu) return;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (open) {
      menu.hidden = false;
      // Next frame so the entrance animation runs after unhiding.
      requestAnimationFrame(() => menu.setAttribute("data-open", ""));
      document.body.style.overflow = "hidden";
      menu.querySelector<HTMLAnchorElement>("a")?.focus();
    } else {
      menu.removeAttribute("data-open");
      menu.hidden = true;
      document.body.style.overflow = "";
      if (document.activeElement && menu.contains(document.activeElement)) {
        burger.focus();
      }
    }
  };

  burger?.addEventListener("click", () =>
    setMenu(burger.getAttribute("aria-expanded") !== "true"),
  );
  menu
    ?.querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setMenu(false)));
  window.addEventListener("keydown", (e) => {
    const open = burger?.getAttribute("aria-expanded") === "true";
    if (e.key === "Escape" && open) {
      setMenu(false);
      return;
    }
    if (e.key === "Tab" && open && menu) {
      const focusable = [
        ...(burger ? [burger] : []),
        ...menu.querySelectorAll<HTMLAnchorElement>("a[href]"),
      ];
      const first = focusable[0];
      const last = focusable.at(-1);
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
  });

  // Crossing into desktop hides the menu via CSS; close it for real too, or
  // the body scroll lock would outlive any visible way to release it.
  window.matchMedia("(min-width: 761px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });
</script>
