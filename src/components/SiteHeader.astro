---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="masthead" id="top">
  <div class="wrap masthead__inner">
    <a href="#top" class="masthead__name" aria-label="George Wall — home">
      <span>George Wall</span>
      <span class="masthead__reg">®</span>
    </a>

    <nav class="masthead__nav" aria-label="Primary">
      <a class="link" href="#work">Work</a>
      <a class="link" href="#archive">Archive</a>
      <a class="link" href="#about">About</a>
      <a class="link" href="https://github.com/georgepwall1991" target="_blank" rel="noopener">
        GitHub<span class="masthead__ext" aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="masthead__tools">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s ease, background 0.4s ease;
  }

  .masthead[data-scrolled] {
    border-bottom-color: var(--rule);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: clamp(3.4rem, 7vw, 4.4rem);
  }

  .masthead__name {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 40, 'WONK' 1, 'wght' 560;
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
    gap: 0.15em;
    white-space: nowrap;
  }

  .masthead__reg {
    font-family: var(--font-mono);
    font-size: 0.5em;
    color: var(--accent);
    transform: translateY(-0.6em);
  }

  .masthead__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .masthead__ext {
    font-size: 0.8em;
    margin-left: 0.1em;
  }

  .masthead__tools {
    display: flex;
    align-items: center;
  }

  @media (max-width: 760px) {
    .masthead__nav {
      display: none;
    }
  }
</style>

<script>
  const masthead = document.querySelector<HTMLElement>('.masthead');
  const onScroll = () => {
    if (!masthead) return;
    if (window.scrollY > 24) masthead.setAttribute('data-scrolled', '');
    else masthead.removeAttribute('data-scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
