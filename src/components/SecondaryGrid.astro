---
import type { Repo } from '../data/github';
import { languageColor, formatCount } from '../lib/format';

interface Entry {
  name: string;
  kicker: string;
  title: string;
  blurb: string;
  cta?: string;
  repo?: Repo;
}
interface Props {
  entries: Entry[];
}
const { entries } = Astro.props;
---

<section class="more">
  <div class="wrap">
    <p class="kicker more__kicker reveal">Also on the bench</p>
    <div class="more__grid">
      {
        entries.map((e) => {
          const href = e.repo?.homepage ?? e.repo?.html_url ?? '#';
          return (
            <a class="card reveal" href={href} target="_blank" rel="noopener">
              <p class="card__kicker">{e.kicker}</p>
              <h3 class="card__title">{e.title}</h3>
              <p class="card__blurb">{e.blurb}</p>
              <div class="card__foot">
                <span class="card__meta">
                  {e.repo?.language && (
                    <span class="card__lang">
                      <span class="lang-dot" style={`--dot:${languageColor(e.repo.language)}`} />
                      {e.repo.language}
                    </span>
                  )}
                  {e.repo && e.repo.stars > 0 && <span class="card__stars">★ {formatCount(e.repo.stars)}</span>}
                </span>
                <span class="card__go" aria-hidden="true">↗</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .more {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }
  .more__kicker {
    margin-bottom: 1.5rem;
  }
  .more__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 1.6rem);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.6rem 1.5rem 1.4rem;
    background: var(--paper-raised);
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    box-shadow: 6px 7px 0 var(--ink);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 11px 0 var(--accent);
  }
  .more__grid .card:nth-child(2) {
    --reveal-delay: 90ms;
  }
  .more__grid .card:nth-child(3) {
    --reveal-delay: 180ms;
  }

  .card__kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card__title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 60, 'WONK' 1, 'wght' 540;
    font-size: clamp(1.5rem, 2.4vw, 1.95rem);
    line-height: 1.02;
  }
  .card__blurb {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-soft);
    flex: 1;
  }
  .card__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .card__meta {
    display: inline-flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-soft);
  }
  .card__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .card__stars {
    color: var(--accent);
  }
  .card__go {
    color: var(--ink-faint);
    transition: transform 0.25s var(--ease), color 0.25s ease;
  }
  .card:hover .card__go {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 860px) {
    .more__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
