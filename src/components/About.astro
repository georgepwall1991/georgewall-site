---
import { SITE } from '../data/site';

interface Props {
  avatar: string;
}
const { avatar } = Astro.props;

const disciplines = [
  {
    no: '01',
    name: 'Backend and distributed systems',
    desc: 'C# calculation engines and Kafka services using CQRS, event sourcing and the transactional outbox.',
  },
  {
    no: '02',
    name: 'Frontend',
    desc: 'React and TypeScript for data-heavy trading tools, using RTK Query, AG Grid and Recharts.',
  },
  {
    no: '03',
    name: 'Compile-time safety',
    desc: 'Roslyn analysers and source generators that catch known problems while code is being written.',
  },
  { no: '04', name: 'Product and iOS', desc: 'SwiftUI apps taken from the first build through App Store review.' },
];

const stack = [
  'C#',
  '.NET',
  'Roslyn',
  'Kafka',
  'EF Core',
  'TypeScript',
  'React',
  'RTK Query',
  'Swift',
  'SwiftUI',
  'Rust',
  'Azure',
  'Docker',
];
---

<section class="about" id="about">
  <div class="wrap about__grid">
    <div class="about__main">
      <p class="kicker reveal">About</p>
      <h2 class="display about__title reveal">
        I like owning the whole thing.
      </h2>

      <div class="about__prose reveal">
        <p class="about__lead">
          I’m George. I’ve spent more than ten years building software in {SITE.location}
          fintech: C# engines that price pension liabilities, Kafka services, and frontends
          built from scratch with React and TypeScript. When the numbers involve people’s
          pensions, correctness is not optional. That has shaped the rest of my work.
        </p>
        <p>
          I like working across the stack. That might mean the Kafka consumer, the C#
          calculation engine, the React grid on top, or a SwiftUI app I take all the way
          through App Store review. I also build the bits that stop mistakes repeating:
          analysers, source generators and migration tools.
        </p>

        <blockquote class="about__quote">
          <p>
            I’d rather catch a mistake in the editor than explain it in production.
          </p>
        </blockquote>

      </div>

      <div class="about__stack reveal">
        <p class="label about__stack-label">Working with</p>
        <ul class="about__stack-list">
          {stack.map((s) => <li class="tag">{s}</li>)}
        </ul>
      </div>
    </div>

    <aside class="about__aside">
      <figure class="about__portrait reveal">
        <img src={avatar} alt="George Wall" width="320" height="320" loading="lazy" />
        <figcaption class="about__portrait-cap">George Wall · {SITE.location}</figcaption>
      </figure>

      <ol class="about__disciplines reveal">
        {
          disciplines.map((d) => (
            <li class="about__disc">
              <span class="about__disc-no">{d.no}</span>
              <span class="about__disc-body">
                <span class="about__disc-name">{d.name}</span>
                <span class="about__disc-desc">{d.desc}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</section>

<style>
  .about {
    padding-top: var(--section-gap);
  }
  .about__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.85fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .about__title {
    font-size: clamp(2.4rem, 4.8vw, 4.3rem);
    margin: 1rem 0 2rem;
    max-width: 15ch;
  }

  .about__prose {
    max-width: 54ch;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.62;
    color: var(--ink-soft);
  }
  .about__prose p + p {
    margin-top: 1.2rem;
  }
  .about__lead::first-letter {
    initial-letter: 3 2;
    -webkit-initial-letter: 3 2;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent-text);
    margin-right: 0.6rem;
    font-variation-settings: 'opsz' 144, 'WONK' 1;
  }
  .about__lead {
    color: var(--ink);
  }

  .about__quote {
    margin: 2rem 0;
    padding-left: 1.4rem;
    border-left: 3px solid var(--accent);
  }
  .about__quote p {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'WONK' 1, 'wght' 480;
    font-style: italic;
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    line-height: 1.3;
    color: var(--ink);
  }

  .about__stack {
    margin-top: 2.5rem;
  }
  .about__stack-label {
    margin-bottom: 0.9rem;
  }
  .about__stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .about__portrait {
    margin: 0 0 2.5rem;
  }
  .about__portrait img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    filter: grayscale(1) contrast(1.1) brightness(1.1);
    mix-blend-mode: screen;
  }
  :global(:root[data-theme='light']) .about__portrait img {
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(1.05);
  }
  .about__portrait-cap {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  .about__disciplines {
    list-style: none;
  }
  .about__disc {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.8rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }
  .about__disc:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .about__disc-no {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-text);
  }
  .about__disc-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .about__disc-name {
    font-weight: 600;
    font-size: 1rem;
  }
  .about__disc-desc {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__portrait {
      max-width: 18rem;
    }
  }
</style>
