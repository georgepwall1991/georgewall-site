---
// The signature element: a miniature editor showing one of George's analysers
// (LinqContraband) catching client-side evaluation in EF Core. The squiggle
// draws on load; the diagnostic chip rises after. This is the brand motif —
// the same red squiggle reappears on every link across the site.
---

<figure class="diag" aria-label="A code editor showing the LinqContraband analyser catching a performance bug">
  <div class="diag__card">
    <div class="diag__bar">
      <span class="diag__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="diag__file">OrdersReport.cs</span>
      <span class="diag__badge">LINQ001</span>
    </div>

    <pre class="diag__code"><code><span class="ln"><span class="t-key">var</span> recent = db.Orders</span>
<span class="ln">    .<span class="flag">ToList</span>()</span>
<span class="ln">    .Where(o =&gt; o.Total &gt; <span class="t-num">1_000</span>)</span>
<span class="ln">    .OrderByDescending(o =&gt; o.Date);</span></code></pre>

    <div class="diag__chip" role="status">
      <span class="diag__chip-dot" aria-hidden="true"></span>
      <span class="diag__chip-body">
        <strong>Client-side evaluation.</strong>
        The whole table is pulled into memory before filtering. Push the predicate
        to the database.
        <span class="diag__quickfix">Quick fix: remove <code>.ToList()</code> ⏎</span>
      </span>
    </div>
  </div>

  <figcaption class="diag__cap">
    Fig.&nbsp;1 — <em>LinqContraband</em> stops an expensive query at compile time.
  </figcaption>
</figure>

<style>
  .diag {
    margin: 0;
  }

  .diag__card {
    background: var(--paper-raised);
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    box-shadow: 10px 12px 0 var(--ink);
    overflow: hidden;
    transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .diag__card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 14px 16px 0 var(--ink);
  }

  .diag__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1.5px solid var(--ink);
    background: var(--paper-sunk);
  }

  .diag__dots {
    display: inline-flex;
    gap: 0.34rem;
  }
  .diag__dots i {
    width: 0.66rem;
    height: 0.66rem;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: transparent;
  }
  .diag__dots i:first-child {
    background: var(--accent);
    border-color: var(--accent);
  }

  .diag__file {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--ink-soft);
  }

  .diag__badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.1em 0.4em;
  }

  .diag__code {
    margin: 0;
    padding: 1.15rem 1.1rem 1.2rem;
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 1.2vw, 0.96rem);
    line-height: 1.85;
    color: var(--ink);
    overflow-x: auto;
  }
  .diag__code .ln {
    display: block;
    white-space: pre;
  }
  .t-key {
    color: var(--ink-faint);
    font-style: italic;
  }
  .t-num {
    color: var(--accent-deep);
  }

  /* The flagged token wears a squiggle that draws on load. */
  .flag {
    position: relative;
  }
  .flag::after {
    content: '';
    position: absolute;
    left: 0;
    right: -0.05em;
    bottom: -0.28em;
    height: 0.32em;
    background-color: var(--accent);
    -webkit-mask: var(--wave) repeat-x left bottom / 0.55em 0.32em;
    mask: var(--wave) repeat-x left bottom / 0.55em 0.32em;
    transform: scaleX(0);
    transform-origin: 0 50%;
    animation: flag-draw 0.7s var(--ease) 1s forwards;
  }

  .diag__chip {
    display: flex;
    gap: 0.7rem;
    margin: 0 0.9rem 1rem;
    padding: 0.8rem 0.9rem;
    background: var(--accent-wash);
    border: 1px solid var(--accent);
    border-left-width: 4px;
    border-radius: 6px;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink);
    opacity: 0;
    transform: translateY(8px);
    animation: chip-in 0.6s var(--ease) 1.7s forwards;
  }

  .diag__chip-dot {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.32rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s ease-out 2.3s infinite;
  }

  .diag__chip-body strong {
    font-weight: 640;
  }

  .diag__quickfix {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-deep);
    letter-spacing: 0.02em;
  }
  .diag__quickfix code {
    font-size: 0.95em;
  }

  .diag__cap {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--ink-faint);
  }
  .diag__cap em {
    color: var(--ink-soft);
    font-style: italic;
  }

  @keyframes flag-draw {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes chip-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--accent-wash);
    }
    70% {
      box-shadow: 0 0 0 0.5rem transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flag::after {
      animation: none;
      transform: scaleX(1);
    }
    .diag__chip {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .diag__chip-dot {
      animation: none;
    }
  }
</style>
