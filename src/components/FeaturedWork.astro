---
import ProjectEntry from './ProjectEntry.astro';
import type { Repo } from '../data/github';
import type { NuGetPackage } from '../data/nuget';
import type { ProjectProof } from '../data/featured';

export interface Entry {
  name: string;
  kicker: string;
  title: string;
  blurb: string;
  primary?: { label: string; href: string };
  package?: NuGetPackage;
  proof?: ProjectProof;
  repo?: Repo;
  anchor: string;
}

interface Props {
  entries: Entry[];
  showAllLink?: boolean;
}
const { entries, showAllLink = false } = Astro.props;
---

<section class="work" id="work">
  <div class="wrap">
    <header class="work__head reveal">
      <p class="kicker">Selected work</p>
      <h2 class="display work__title">Things built to stop other things breaking.</h2>
      <p class="work__intro">
        Most of the open-source work sits just before the mess: analysers, source
        generators and CLIs that make bad code complain early, where it is still cheap
        to fix.
      </p>
    </header>

    <div class="work__list">
      {
        entries.map((e, i) => (
          <ProjectEntry
            index={i + 1}
            kicker={e.kicker}
            title={e.title}
            blurb={e.blurb}
            repo={e.repo}
            primary={e.primary}
            package={e.package}
            proof={e.proof}
            anchor={e.anchor}
          />
        ))
      }
    </div>
    {
      showAllLink && (
        <div class="work__more reveal">
          <a class="btn btn--ghost" href="/work">
            Explore every project <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .work {
    padding-top: var(--section-gap);
  }

  .work__head {
    max-width: 52rem;
    margin-bottom: clamp(1rem, 3vw, 2.5rem);
  }
  .work__title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    margin: 1rem 0 1.4rem;
    max-width: 16ch;
  }
  .work__intro {
    font-size: clamp(1.02rem, 1.4vw, 1.22rem);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 50ch;
  }

  /* The first entry's top rule meets the section intro cleanly. */
  .work__list :global(.entry:last-child) {
    border-bottom: 1.5px solid var(--ink);
  }
  .work__more {
    display: flex;
    justify-content: center;
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }
</style>
