---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="colophon" id="contact">
  <div class="wrap">
    <div class="colophon__cta reveal">
      <p class="kicker">Get in touch</p>
      <h2 class="display colophon__title">
        Got something worth <em>building</em>?
      </h2>
      <p class="colophon__lede">
        Product work, a .NET codebase that needs guardrails, or an idea you want shipped.
        Email is the fastest way to reach me.
      </p>
      <div class="colophon__actions">
        <a class="btn" href={`mailto:${SITE.email}`}>
          {SITE.email}<span class="arrow" aria-hidden="true">↗</span>
        </a>
        <button class="btn btn--ghost colophon__copy" type="button" data-email={SITE.email} hidden>
          <span class="colophon__copy-label">Copy address</span>
        </button>
        <a class="btn btn--ghost" href={SITE.github} target="_blank" rel="noopener">
          GitHub<span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="colophon__foot">
      <div class="colophon__col">
        <p class="label">Colophon</p>
        <p class="colophon__note">
          Set in <span class="serif">Fraunces</span>, Archivo &amp; JetBrains&nbsp;Mono.
          Built with Astro; repository data read from the GitHub API. Static, frontend-only,
          hosted on Vercel because simple is usually enough.
        </p>
      </div>
      <div class="colophon__col">
        <p class="label">Index</p>
        <ul class="colophon__links">
          <li><a class="link" href="/#ventures">Ventures</a></li>
          <li><a class="link" href="/#apps">Apps</a></li>
          <li><a class="link" href="/work">All projects</a></li>
          <li><a class="link" href="/writing">Writing</a></li>
          <li><a class="link" href="/#about">About</a></li>
          <li><a class="link" href="#top">Back to top ↑</a></li>
        </ul>
      </div>
      <div class="colophon__col colophon__col--end">
        <p class="label">No.&nbsp;{SITE.issueNo} · {SITE.location}</p>
        <p class="colophon__sign">George&nbsp;Wall</p>
        <p class="colophon__copy">© {year} · georgewall.uk</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .colophon {
    margin-top: var(--section-gap);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .colophon__cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    padding: clamp(3.5rem, 9vw, 7rem) clamp(1.25rem, 4vw, 3rem);
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    border-radius: calc(var(--radius) + 10px);
    border: 1px solid var(--rule);
    background:
      radial-gradient(ellipse 60% 80% at 50% 120%, rgba(255, 91, 55, 0.35), transparent 70%),
      var(--paper-raised);
  }
  .colophon__title {
    font-size: clamp(2.6rem, 7.5vw, 6.6rem);
    margin: 1.2rem auto 1.4rem;
    max-width: 14ch;
  }
  .colophon__title em {
    color: var(--accent);
  }
  .colophon__lede {
    max-width: 44ch;
    margin: 0 auto 2.4rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 0.96rem + 0.3vw, 1.15rem);
    line-height: 1.6;
  }

  .colophon__actions {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .colophon__foot {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .colophon__col .label {
    margin-bottom: 0.9rem;
  }
  .colophon__note {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 38ch;
  }
  .colophon__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .colophon__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .colophon__col--end {
    text-align: right;
  }
  .colophon__sign {
    font-variation-settings: 'wght' 700, 'wdth' 110;
    letter-spacing: -0.05em;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    line-height: 1;
    margin: 0.4rem 0;
  }
  .colophon__reg {
    font-family: var(--font-mono);
    font-size: 0.4em;
    color: var(--accent-text);
    vertical-align: super;
  }
  .colophon__copy {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-faint);
  }

  .colophon__copy[data-copied] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  @media (max-width: 760px) {
    .colophon__foot {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
    .colophon__col--end {
      text-align: left;
    }
  }
</style>

<script>
  // Copy-to-clipboard for the email CTA. The button ships hidden and is only
  // revealed when the Clipboard API exists, so no-JS/insecure contexts never
  // see a dead control.
  const copyBtn = document.querySelector<HTMLButtonElement>('.colophon__copy');
  const copyLabel = copyBtn?.querySelector<HTMLElement>('.colophon__copy-label');

  if (copyBtn && copyLabel && navigator.clipboard?.writeText) {
    copyBtn.hidden = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.email!);
        copyBtn.setAttribute('data-copied', '');
        copyLabel.textContent = 'Copied ✓';
        clearTimeout(timer);
        timer = setTimeout(() => {
          copyBtn.removeAttribute('data-copied');
          copyLabel.textContent = 'Copy address';
        }, 2000);
      } catch (_) {
        /* Clipboard refused, so leave the mailto link as the path. */
      }
    });
  }
</script>
