---
// The full-stack proof, shown rather than claimed: three editor panes, one per
// layer — React/TS at the front, a C# engine in the middle, Kafka plumbing
// underneath. Snippets are hand-tokenised (set:html) against the site palette.
const PANES = [
  {
    file: 'SchemeGrid.tsx',
    badge: 'TSX',
    layer: 'The front',
    code: [
      `<span class="tk-k">const</span> { data: schemes } = <span class="tk-f">useGetSchemesQuery</span>();`,
      ``,
      `<span class="tk-k">return</span> &lt;<span class="tk-t">AgGridReact</span> rowData={schemes}`,
      `  columnDefs={columns} animateRows /&gt;;`,
    ],
    caption:
      'Data-dense React + TypeScript — RTK Query, AG-Grid, Recharts. Frontends built from scratch for institutional users who read numbers for a living.',
  },
  {
    file: 'LiabilityEngine.cs',
    badge: 'C#',
    layer: 'The middle',
    code: [
      `<span class="tk-k">var</span> curve = <span class="tk-t">DiscountCurve</span>.<span class="tk-f">From</span>(market);`,
      ``,
      `<span class="tk-k">var</span> pv = scheme.CashFlows`,
      `    .<span class="tk-f">Sum</span>(cf =&gt; cf.Amount * curve.<span class="tk-f">Df</span>(cf.Date));`,
    ],
    caption:
      'C# calculation engines — liability metrics, discount curves and funding ratios. Right answers, every time, with an audit trail.',
  },
  {
    file: 'OutboxRelay.cs',
    badge: 'C#',
    layer: 'The plumbing',
    code: [
      `<span class="tk-k">await</span> outbox.<span class="tk-f">Enqueue</span>(evt, tx);`,
      `<span class="tk-c">// SQL + Kafka commit together — no lost events</span>`,
      `<span class="tk-k">await</span> tx.<span class="tk-f">CommitAsync</span>(ct);`,
    ],
    caption:
      'Event-driven .NET on Kafka — transactional outbox, idempotency keys, schema registry. The plumbing that is not allowed to lose money.',
  },
];

const RAIL = ['React/TS UI', 'ASP.NET API', 'Kafka events', 'SQL · Redis'];
---

<section class="stack" id="stack">
  <div class="wrap">
    <header class="stack__head reveal">
      <p class="kicker">The range</p>
      <h2 class="display stack__title">Every layer, one pair of hands.</h2>
      <p class="stack__intro">
        Ten years in fintech buys the whole map. The same person tuning the grid render
        also wrote the calculation engine underneath it — and the Kafka consumer feeding
        them both.
      </p>
    </header>

    <div class="stack__rail reveal" aria-label="The stack, front to back">
      {
        RAIL.map((stop, i) => (
          <>
            <span class="stack__stop">{stop}</span>
            {i < RAIL.length - 1 && (
              <span class="stack__arrow" aria-hidden="true">
                ⟶
              </span>
            )}
          </>
        ))
      }
    </div>

    <div class="stack__grid">
      {
        PANES.map((pane, i) => (
          <figure class="pane reveal" style={`--reveal-delay:${i * 110}ms`}>
            <div class="pane__bar">
              <span class="pane__dots" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <span class="pane__file">{pane.file}</span>
              <span class="pane__badge">{pane.badge}</span>
            </div>
            <pre class="pane__code"><code>{pane.code.map((line) => (
              <span class="ln" set:html={line || '&nbsp;'} />
            ))}</code></pre>
            <figcaption class="pane__cap">
              <span class="pane__layer">{pane.layer}</span>
              {pane.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack {
    padding-top: var(--section-gap);
  }

  .stack__head {
    max-width: 52rem;
  }
  .stack__title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    margin: 1rem 0 1.4rem;
    max-width: 16ch;
  }
  .stack__intro {
    font-size: clamp(1.02rem, 1.4vw, 1.22rem);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .stack__rail {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.6vw, 1.2rem);
    flex-wrap: wrap;
    margin: clamp(1.6rem, 4vw, 2.6rem) 0 clamp(1.4rem, 3vw, 2.2rem);
    padding-block: 0.9rem;
    border-top: 1.5px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .stack__stop {
    white-space: nowrap;
  }
  .stack__arrow {
    color: var(--accent);
  }

  .stack__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 1.6rem);
    align-items: stretch;
  }

  .pane {
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--paper-raised);
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    box-shadow: 6px 7px 0 var(--ink);
    overflow: hidden;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .pane:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 11px 0 var(--accent);
  }

  .pane__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.85rem;
    border-bottom: 1.5px solid var(--ink);
    background: var(--paper-sunk);
  }
  .pane__dots {
    display: inline-flex;
    gap: 0.32rem;
  }
  .pane__dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .pane__dots i:first-child {
    background: var(--accent);
    border-color: var(--accent);
  }
  .pane__file {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-soft);
  }
  .pane__badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.1em 0.4em;
  }

  .pane__code {
    margin: 0;
    padding: 1rem 1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.8;
    color: var(--ink);
    overflow-x: auto;
    flex: 1;
  }
  .pane__code .ln {
    display: block;
    white-space: pre;
  }
  .pane__code :global(.tk-k) {
    color: var(--ink-faint);
    font-style: italic;
  }
  .pane__code :global(.tk-t) {
    color: var(--accent-deep);
  }
  .pane__code :global(.tk-f) {
    font-weight: 600;
  }
  .pane__code :global(.tk-c) {
    color: var(--ink-faint);
  }

  .pane__cap {
    padding: 0.9rem 1rem 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .pane__layer {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  @media (max-width: 940px) {
    .stack__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
