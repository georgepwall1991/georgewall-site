---
// The full-stack proof, shown rather than claimed: three editor panes, one per
// layer — React/TS at the front, a C# engine in the middle, Kafka plumbing
// underneath. Snippets are hand-tokenised (set:html) against the site palette,
// and each pane is "signed off" by the relevant toolchain — including George's
// own analysers, which is the whole joke.
interface Line {
  html: string;
  /** Current-line highlight, like the editor caret line. */
  hl?: boolean;
}

interface Pane {
  path: string;
  file: string;
  badge: string;
  layer: string;
  code: Line[];
  verdict: string;
  caption: string;
}

const PANES: Pane[] = [
  {
    path: 'src/features/schemes/',
    file: 'SchemeGrid.tsx',
    badge: 'TSX',
    layer: 'The front',
    code: [
      {
        html: `<span class="tk-k">const</span> { data: schemes = [] } = <span class="tk-f">useSchemesQuery</span>();`,
      },
      { html: `` },
      { html: `<span class="tk-k">return</span> (` },
      {
        html: `  &lt;<span class="tk-t">AgGridReact</span> rowData={schemes}`,
        hl: true,
      },
      { html: `    columnDefs={columns} animateRows /&gt;` },
      { html: `);` },
    ],
    verdict: 'tsc --strict · 0 errors',
    caption:
      'Data-dense React + TypeScript — RTK Query, AG-Grid, Recharts. Frontends built from scratch for institutional users who read numbers for a living.',
  },
  {
    path: 'src/Engine/',
    file: 'LiabilityEngine.cs',
    badge: 'C#',
    layer: 'The middle',
    code: [
      {
        html: `<span class="tk-k">var</span> curve = <span class="tk-t">DiscountCurve</span>.<span class="tk-f">From</span>(market, asOf);`,
      },
      { html: `` },
      {
        html: `<span class="tk-k">var</span> presentValue = scheme.CashFlows.<span class="tk-f">Sum</span>(cf =&gt;`,
      },
      {
        html: `    cf.Amount * curve.<span class="tk-f">DiscountFactor</span>(cf.Date));`,
        hl: true,
      },
    ],
    verdict: 'LinqContraband ✓ · 0 diagnostics',
    caption:
      'C# calculation engines — liability metrics, discount curves and funding ratios. Right answers, every time, with an audit trail.',
  },
  {
    path: 'src/Messaging/',
    file: 'OutboxRelay.cs',
    badge: 'C#',
    layer: 'The plumbing',
    code: [
      {
        html: `<span class="tk-k">await</span> outbox.<span class="tk-f">Enqueue</span>(tradeRebooked, tx, ct);`,
        hl: true,
      },
      { html: `<span class="tk-k">await</span> tx.<span class="tk-f">CommitAsync</span>(ct);` },
      { html: `<span class="tk-c">// relayed to Kafka after commit</span>` },
    ],
    verdict: 'CancelCop ✓ · token propagated',
    caption:
      'Event-driven .NET on Kafka — transactional outbox, idempotency keys, schema registry. The plumbing that is not allowed to lose money.',
  },
];

const RAIL = ['React/TS UI', 'ASP.NET API', 'Kafka events', 'SQL · Redis'];
---

<section class="stack" id="stack">
  <div class="wrap">
    <header class="stack__head reveal">
      <p class="kicker">The range</p>
      <h2 class="display stack__title">Every layer, one pair of hands.</h2>
      <p class="stack__intro">
        Ten years in fintech buys the whole map. The same person tuning the grid render
        also wrote the calculation engine underneath it — and the Kafka consumer feeding
        them both.
      </p>
    </header>

    <div class="stack__rail reveal" aria-label="The stack, front to back">
      {
        RAIL.map((stop, i) => (
          <>
            <span class="stack__stop">{stop}</span>
            {i < RAIL.length - 1 && (
              <span class="stack__arrow" aria-hidden="true">
                ⟶
              </span>
            )}
          </>
        ))
      }
      <span class="stack__pulse" aria-hidden="true"></span>
    </div>

    <div class="stack__grid">
      {
        PANES.map((pane, i) => (
          <figure class={`pane reveal${i === 1 ? ' pane--lift' : ''}`} style={`--reveal-delay:${i * 110}ms`}>
            <div class="pane__bar">
              <span class="pane__dots" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <span class="pane__file">
                <span class="pane__path">{pane.path}</span>{pane.file}
              </span>
              <span class="pane__badge">{pane.badge}</span>
            </div>
            <pre class="pane__code"><code>{pane.code.map((line, li) => (
              <span
                class={`ln${line.hl ? ' ln--hl' : ''}`}
                style={`--i:${li}`}
              ><span class="ln__code" set:html={line.html || '&nbsp;'} />{li === pane.code.length - 1 && (
                <span class="caret" aria-hidden="true" />
              )}</span>
            ))}</code></pre>
            <div class="pane__verdict">
              <span class="pane__verdict-dot" aria-hidden="true"></span>
              {pane.verdict}
            </div>
            <figcaption class="pane__cap">
              <span class="pane__layer">{pane.layer}</span>
              {pane.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack {
    padding-top: var(--section-gap);
  }

  .stack__head {
    max-width: 52rem;
  }
  .stack__title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    margin: 1rem 0 1.4rem;
    max-width: 16ch;
  }
  .stack__intro {
    font-size: clamp(1.02rem, 1.4vw, 1.22rem);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .stack__rail {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.6vw, 1.2rem);
    flex-wrap: wrap;
    margin: clamp(1.6rem, 4vw, 2.6rem) 0 clamp(1.6rem, 3.4vw, 2.6rem);
    padding-block: 0.9rem;
    border-top: 1.5px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .stack__stop {
    white-space: nowrap;
  }
  .stack__arrow {
    color: var(--accent);
  }

  /* A request travelling the stack: a dot runs the rail's bottom rule. */
  .stack__pulse {
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0.45rem;
    height: 3px;
    border-radius: 2px;
    background: var(--accent);
    animation: rail-run 5.5s var(--ease) infinite;
  }

  @keyframes rail-run {
    0% {
      left: 0%;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 0.45rem);
      opacity: 0;
    }
  }

  .stack__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 1.6rem);
    align-items: start;
  }

  .pane {
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--paper-raised);
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    box-shadow: 6px 7px 0 var(--ink);
    overflow: hidden;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .pane:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 11px 0 var(--accent);
  }

  /* The middle pane sits a beat higher — editorial rhythm, not a grid. */
  .pane--lift {
    margin-top: -1.1rem;
  }

  .pane__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.85rem;
    border-bottom: 1.5px solid var(--ink);
    background: var(--paper-sunk);
  }
  .pane__dots {
    display: inline-flex;
    gap: 0.32rem;
    flex: none;
  }
  .pane__dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .pane__dots i:first-child {
    background: var(--accent);
    border-color: var(--accent);
  }
  .pane__file {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pane__path {
    color: var(--ink-faint);
  }
  .pane__badge {
    margin-left: auto;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.1em 0.4em;
  }

  .pane__code {
    margin: 0;
    padding: 0.9rem 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.85;
    color: var(--ink);
    overflow-x: auto;
    flex: 1;
    counter-reset: ln;
  }

  /* Gutter line numbers via counters; the highlighted line wears the editor's
     current-line wash and an accent gutter bar. */
  .pane__code .ln {
    display: block;
    white-space: pre;
    counter-increment: ln;
    padding-right: 1rem;
    position: relative;
  }
  .pane__code .ln::before {
    content: counter(ln);
    display: inline-block;
    width: 1.8rem;
    padding-right: 0.6rem;
    text-align: right;
    color: var(--ink-faint);
    opacity: 0.7;
    font-size: 0.88em;
    user-select: none;
  }
  .ln--hl {
    background: var(--accent-wash);
  }
  .ln--hl::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2.5px;
    background: var(--accent);
  }

  /* Lines type themselves in once the pane scrolls into view. */
  :global(html.js) .pane__code .ln__code {
    opacity: 0;
  }
  :global(html.js) .pane.is-in .ln__code {
    animation: ln-in 0.4s var(--ease) forwards;
    animation-delay: calc(var(--i) * 90ms + 350ms);
  }
  .ln__code {
    display: inline;
  }
  @keyframes ln-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Blinking block caret parked after the last line. */
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: caret-blink 1.1s steps(1) infinite;
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .pane__code :global(.tk-k) {
    color: var(--ink-faint);
    font-style: italic;
  }
  .pane__code :global(.tk-t) {
    color: var(--accent-deep);
  }
  .pane__code :global(.tk-f) {
    font-weight: 600;
  }
  .pane__code :global(.tk-c) {
    color: var(--ink-faint);
  }

  /* The sign-off: the toolchain (and George's own analysers) approve. */
  .pane__verdict {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--rule);
    background: var(--paper-sunk);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .pane__verdict-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .pane__cap {
    padding: 0.9rem 1rem 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .pane__layer {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .stack__pulse,
    .caret {
      animation: none;
    }
    .caret {
      opacity: 1;
    }
    :global(html.js) .pane__code .ln__code,
    :global(html.js) .pane.is-in .ln__code {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 940px) {
    .stack__grid {
      grid-template-columns: 1fr;
    }
    .pane--lift {
      margin-top: 0;
    }
  }
</style>
